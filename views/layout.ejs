<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="<%= description %>">
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/favicon.png">
    
    <!-- Fonts - Modern Craftsman Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Main CSS -->
    <link rel="stylesheet" href="/css/style.css">

    <!-- Tailwind CSS (utility classes + background animations) -->
    <link rel="stylesheet" href="/css/tailwind.css">

    <!-- Additional CSS if needed -->
    <%- typeof additionalStyles !== 'undefined' ? additionalStyles : '' %>
</head>
<body>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "GK Homes and Roofing",
      "url": "https://gk-roofing.com",
      "telephone": "+1-512-564-3679",
      "areaServed": [
        "Leander", "Liberty Hill", "Georgetown", "Cedar Park", "Round Rock",
        "Jonestown", "Lago Vista", "Burnet", "Pflugerville", "Lake Travis"
      ],
      "image": "https://gk-roofing.com/images/logos/gk-logo.png",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Austin",
        "addressRegion": "TX",
        "addressCountry": "US"
      },
      "sameAs": []
    }
    </script>
    <%- include('partials/header') %>
    
    <main>
        <%- body %>
    </main>
    
    <%- include('partials/footer') %>
    
    <!-- Scroll to Top Button -->
    <div class="scroll-top">
        <i class="fas fa-arrow-up"></i>
    </div>
    
    <!-- Quick Quote Floating Form -->
    <div id="quick-quote-container" class="quick-quote-container">
        <div id="quick-quote-toggle" class="quick-quote-toggle">
            <div class="toggle-pulse"></div>
            <i class="fas fa-calculator"></i>
            <span class="quick-quote-label">Quick Quote</span>
        </div>

        <div id="quick-quote-widget" class="quick-quote-widget">
            <div class="quick-quote-header">
                <div class="quick-quote-title">
                    <i class="fas fa-file-invoice-dollar"></i>
                    <span>Get a Quick Quote</span>
                </div>
                <button id="quick-quote-close" class="quick-quote-close">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="quick-quote-body">
                <p class="quick-quote-subtitle">Fill out this form and we'll get back to you within 24 hours!</p>

                <form id="quick-quote-form" class="quick-quote-form">
                    <div class="form-field">
                        <div class="field-icon"><i class="fas fa-user"></i></div>
                        <input type="text" name="name" placeholder="Your Name" required>
                    </div>

                    <div class="form-field">
                        <div class="field-icon"><i class="fas fa-envelope"></i></div>
                        <input type="email" name="email" placeholder="Email Address" required>
                    </div>

                    <div class="form-field">
                        <div class="field-icon"><i class="fas fa-phone"></i></div>
                        <input type="tel" name="phone" placeholder="Phone Number" required>
                    </div>

                    <div class="form-field">
                        <div class="field-icon"><i class="fas fa-clipboard-list"></i></div>
                        <select name="service" required>
                            <option value="">Select Service</option>
                            <option value="roofing">Roofing</option>
                            <option value="solar">Solar Roofing</option>
                            <option value="remodeling">Home Remodeling</option>
                            <option value="construction">New Construction</option>
                            <option value="other">Other</option>
                        </select>
                    </div>

                    <div class="form-field textarea-field">
                        <div class="field-icon"><i class="fas fa-comment-alt"></i></div>
                        <textarea name="message" placeholder="Brief project description..." rows="3"></textarea>
                    </div>

                    <button type="submit" class="quick-quote-submit">
                        <span>Get My Free Quote</span>
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </form>

                <div id="quick-quote-success" class="quick-quote-success" style="display: none;">
                    <div class="success-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <h3>Thank You!</h3>
                    <p>We've received your request and will contact you within 24 hours.</p>
                    <button id="quick-quote-reset" class="quick-quote-reset">Submit Another</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Confetti Canvas -->
    <canvas id="confetti-canvas"></canvas>
    
    <!-- Main JavaScript -->
    <script src="/js/main.js"></script>
    <script src="/js/quick-quote.js"></script>
    <script src="/js/background-animation.js"></script>
    <script src="/js/interactive-selector.js"></script>
    <!-- Owens Corning Widget Script (available site-wide for widget placement) -->
    <script src="https://apis.owenscorning.com/client/widget.js" async></script>
    
    <!-- Additional scripts if needed -->
    <%- typeof additionalScripts !== 'undefined' ? additionalScripts : '' %>
</body>
</html> 