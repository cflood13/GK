<style>
/* ═══════════════════════════════════════════════════════════════════════════
   FINANCING PAGE - "Financial Empowerment" Aesthetic
   Clean, approachable design that makes financing feel accessible
   ═══════════════════════════════════════════════════════════════════════════ */

@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&family=Work+Sans:wght@300;400;500;600;700&display=swap');

:root {
    --finance-forest: #166534;
    --finance-forest-dark: #14532D;
    --finance-mint: #10B981;
    --finance-mint-light: #34D399;
    --finance-soft-white: #F9FAFB;
    --finance-slate: #334155;
    --finance-slate-light: #64748B;
    --finance-gold: #FBBF24;
    --finance-gold-dark: #F59E0B;
    --finance-white: #FFFFFF;
    --finance-gray: #E5E7EB;
}

.financing-page {
    font-family: 'Work Sans', sans-serif;
    background: var(--finance-soft-white);
    color: var(--finance-slate);
    overflow-x: hidden;
}

/* ═══════════════════════════════════════════════════════════════════════════
   HERO SECTION
   ═══════════════════════════════════════════════════════════════════════════ */

.financing-hero {
    position: relative;
    min-height: 80vh;
    background: linear-gradient(165deg, var(--finance-forest) 0%, var(--finance-forest-dark) 60%, #0F4429 100%);
    display: flex;
    align-items: center;
    overflow: hidden;
}

.financing-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
        radial-gradient(ellipse at 30% 20%, rgba(16, 185, 129, 0.2) 0%, transparent 50%),
        radial-gradient(ellipse at 70% 80%, rgba(251, 191, 36, 0.1) 0%, transparent 40%);
    pointer-events: none;
}

/* Decorative shapes */
.financing-hero::after {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 80%;
    height: 200%;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, transparent 60%);
    transform: rotate(-15deg);
    pointer-events: none;
}

.financing-hero-content {
    position: relative;
    z-index: 2;
    max-width: 1400px;
    margin: 0 auto;
    padding: 120px 5%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
}

.financing-hero-text {
    animation: heroSlideIn 0.8s ease-out;
}

@keyframes heroSlideIn {
    from {
        opacity: 0;
        transform: translateX(-40px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

.financing-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(16, 185, 129, 0.2);
    border: 1px solid rgba(16, 185, 129, 0.4);
    padding: 10px 20px;
    border-radius: 50px;
    margin-bottom: 30px;
}

.financing-hero-badge i {
    color: var(--finance-mint-light);
    font-size: 1rem;
}

.financing-hero-badge span {
    color: var(--finance-mint-light);
    font-family: 'Work Sans', sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}

.financing-hero h1 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2.8rem, 5vw, 4rem);
    font-weight: 600;
    color: var(--finance-white);
    line-height: 1.15;
    margin-bottom: 25px;
}

.financing-hero h1 span {
    color: var(--finance-gold);
    font-style: italic;
}

.financing-hero-description {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.7;
    margin-bottom: 40px;
    max-width: 520px;
}

.financing-hero-cta {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
}

.financing-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    font-family: 'Work Sans', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 12px;
    transition: all 0.3s ease;
}

.financing-btn.primary {
    background: var(--finance-gold);
    color: var(--finance-forest-dark);
}

.financing-btn.primary:hover {
    background: var(--finance-gold-dark);
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(251, 191, 36, 0.3);
}

.financing-btn.secondary {
    background: rgba(255, 255, 255, 0.1);
    color: var(--finance-white);
    border: 2px solid rgba(255, 255, 255, 0.3);
}

.financing-btn.secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.5);
}

/* Hero Visual */
.financing-hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    animation: heroVisualFloat 1s ease-out 0.3s both;
}

@keyframes heroVisualFloat {
    from {
        opacity: 0;
        transform: translateY(40px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.financing-calculator-visual {
    position: relative;
    width: 400px;
    height: 400px;
}

.financing-calc-main {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 280px;
    height: 320px;
    background: var(--finance-white);
    border-radius: 30px;
    padding: 30px;
    box-shadow:
        0 30px 60px rgba(0, 0, 0, 0.2),
        0 10px 20px rgba(0, 0, 0, 0.1);
    animation: calcFloat 5s ease-in-out infinite;
}

@keyframes calcFloat {
    0%, 100% { transform: translate(-50%, -50%) translateY(0); }
    50% { transform: translate(-50%, -50%) translateY(-12px); }
}

.financing-calc-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 25px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--finance-gray);
}

.financing-calc-icon {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, var(--finance-forest), var(--finance-mint));
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--finance-white);
    font-size: 1.5rem;
}

.financing-calc-title {
    font-family: 'Fraunces', serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--finance-slate);
}

.financing-calc-amount {
    text-align: center;
    margin-bottom: 30px;
}

.financing-calc-amount small {
    font-size: 0.85rem;
    color: var(--finance-slate-light);
    text-transform: uppercase;
    letter-spacing: 1px;
}

.financing-calc-amount .amount {
    font-family: 'Fraunces', serif;
    font-size: 3rem;
    font-weight: 700;
    color: var(--finance-forest);
    display: block;
    line-height: 1.2;
}

.financing-calc-amount .amount sup {
    font-size: 1.5rem;
    vertical-align: super;
}

.financing-calc-amount .period {
    font-size: 1rem;
    color: var(--finance-slate-light);
}

.financing-calc-details {
    display: flex;
    justify-content: space-between;
    padding: 20px;
    background: var(--finance-soft-white);
    border-radius: 15px;
}

.financing-calc-detail {
    text-align: center;
}

.financing-calc-detail span {
    display: block;
    font-size: 0.75rem;
    color: var(--finance-slate-light);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 5px;
}

.financing-calc-detail strong {
    font-family: 'Fraunces', serif;
    font-size: 1.2rem;
    color: var(--finance-slate);
}

/* Floating elements around calculator */
.financing-float-element {
    position: absolute;
    background: var(--finance-white);
    border-radius: 15px;
    padding: 15px 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    display: flex;
    align-items: center;
    gap: 10px;
}

.financing-float-element.approved {
    top: 10%;
    right: -10%;
    animation: floatBounce 4s ease-in-out infinite;
}

.financing-float-element.rate {
    bottom: 15%;
    left: -15%;
    animation: floatBounce 4s ease-in-out infinite 1s;
}

@keyframes floatBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
}

.financing-float-element i {
    width: 40px;
    height: 40px;
    background: var(--finance-mint);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--finance-white);
    font-size: 1rem;
}

.financing-float-element span {
    font-weight: 600;
    color: var(--finance-slate);
    font-size: 0.9rem;
}

/* ═══════════════════════════════════════════════════════════════════════════
   BENEFITS SECTION
   ═══════════════════════════════════════════════════════════════════════════ */

.financing-benefits {
    padding: 120px 5%;
    background: var(--finance-white);
}

.financing-benefits-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 70px;
}

.financing-section-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--finance-mint);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 18px;
}

.financing-section-tag::before,
.financing-section-tag::after {
    content: '';
    width: 25px;
    height: 2px;
    background: var(--finance-mint);
    border-radius: 2px;
}

.financing-benefits h2 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2.2rem, 4vw, 2.8rem);
    color: var(--finance-slate);
    margin-bottom: 18px;
}

.financing-benefits-description {
    font-size: 1.1rem;
    color: var(--finance-slate-light);
    line-height: 1.7;
}

.financing-benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    max-width: 1200px;
    margin: 0 auto;
}

.financing-benefit-card {
    background: var(--finance-soft-white);
    border-radius: 20px;
    padding: 40px 30px;
    text-align: center;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
}

.financing-benefit-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--finance-gray);
    transition: background 0.4s ease;
}

.financing-benefit-card:hover {
    background: var(--finance-white);
    transform: translateY(-8px);
    box-shadow: 0 20px 50px rgba(22, 101, 52, 0.1);
}

.financing-benefit-card:hover::before {
    background: linear-gradient(90deg, var(--finance-mint), var(--finance-forest));
}

.financing-benefit-icon {
    width: 70px;
    height: 70px;
    margin: 0 auto 25px;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(22, 101, 52, 0.1));
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--finance-forest);
    font-size: 1.8rem;
    transition: all 0.4s ease;
}

.financing-benefit-card:hover .financing-benefit-icon {
    background: linear-gradient(135deg, var(--finance-forest), var(--finance-mint));
    color: var(--finance-white);
    transform: scale(1.1);
}

.financing-benefit-card h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.3rem;
    color: var(--finance-slate);
    margin-bottom: 12px;
}

.financing-benefit-card p {
    font-size: 0.95rem;
    color: var(--finance-slate-light);
    line-height: 1.6;
}

/* ═══════════════════════════════════════════════════════════════════════════
   FINANCING OPTIONS SECTION
   ═══════════════════════════════════════════════════════════════════════════ */

.financing-options {
    padding: 120px 5%;
    background: linear-gradient(180deg, var(--finance-soft-white) 0%, var(--finance-white) 100%);
}

.financing-options-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 70px;
}

.financing-options h2 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2.2rem, 4vw, 2.8rem);
    color: var(--finance-slate);
    margin-bottom: 18px;
}

.financing-options-description {
    font-size: 1.1rem;
    color: var(--finance-slate-light);
    line-height: 1.7;
}

.financing-options-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    max-width: 1200px;
    margin: 0 auto;
}

.financing-option-card {
    background: var(--finance-white);
    border: 2px solid var(--finance-gray);
    border-radius: 24px;
    padding: 45px 35px;
    position: relative;
    transition: all 0.4s ease;
    overflow: hidden;
}

.financing-option-card:hover {
    border-color: var(--finance-mint);
    transform: translateY(-10px);
    box-shadow: 0 25px 60px rgba(22, 101, 52, 0.12);
}

.financing-option-card.featured {
    background: var(--finance-forest);
    border-color: var(--finance-forest);
    transform: scale(1.03);
}

.financing-option-card.featured:hover {
    transform: scale(1.03) translateY(-10px);
}

.financing-option-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    background: var(--finance-gold);
    color: var(--finance-forest-dark);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.financing-option-icon {
    width: 65px;
    height: 65px;
    background: var(--finance-soft-white);
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--finance-forest);
    font-size: 1.8rem;
    margin-bottom: 25px;
}

.financing-option-card.featured .financing-option-icon {
    background: rgba(255, 255, 255, 0.15);
    color: var(--finance-gold);
}

.financing-option-card h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.5rem;
    color: var(--finance-slate);
    margin-bottom: 10px;
}

.financing-option-card.featured h3 {
    color: var(--finance-white);
}

.financing-option-rate {
    margin-bottom: 20px;
}

.financing-option-rate .rate {
    font-family: 'Fraunces', serif;
    font-size: 3rem;
    font-weight: 700;
    color: var(--finance-forest);
    line-height: 1;
}

.financing-option-card.featured .financing-option-rate .rate {
    color: var(--finance-gold);
}

.financing-option-rate .label {
    font-size: 0.9rem;
    color: var(--finance-slate-light);
    margin-top: 5px;
}

.financing-option-card.featured .financing-option-rate .label {
    color: rgba(255, 255, 255, 0.7);
}

.financing-option-description {
    font-size: 0.95rem;
    color: var(--finance-slate-light);
    line-height: 1.6;
    margin-bottom: 25px;
}

.financing-option-card.featured .financing-option-description {
    color: rgba(255, 255, 255, 0.8);
}

.financing-option-features {
    list-style: none;
    padding: 0;
    margin: 0 0 30px;
}

.financing-option-features li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    font-size: 0.95rem;
    color: var(--finance-slate);
    border-bottom: 1px solid var(--finance-gray);
}

.financing-option-card.featured .financing-option-features li {
    color: rgba(255, 255, 255, 0.9);
    border-color: rgba(255, 255, 255, 0.15);
}

.financing-option-features li:last-child {
    border-bottom: none;
}

.financing-option-features li i {
    color: var(--finance-mint);
    font-size: 1rem;
}

.financing-option-card.featured .financing-option-features li i {
    color: var(--finance-gold);
}

.financing-option-cta {
    display: block;
    text-align: center;
    padding: 14px 28px;
    background: var(--finance-forest);
    color: var(--finance-white);
    text-decoration: none;
    font-weight: 600;
    border-radius: 12px;
    transition: all 0.3s ease;
}

.financing-option-card.featured .financing-option-cta {
    background: var(--finance-gold);
    color: var(--finance-forest-dark);
}

.financing-option-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(22, 101, 52, 0.25);
}

.financing-option-card.featured .financing-option-cta:hover {
    box-shadow: 0 10px 30px rgba(251, 191, 36, 0.4);
}

/* ═══════════════════════════════════════════════════════════════════════════
   APPLICATION PROCESS SECTION
   ═══════════════════════════════════════════════════════════════════════════ */

.financing-process {
    padding: 120px 5%;
    background: var(--finance-forest);
    position: relative;
    overflow: hidden;
}

.financing-process::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
        radial-gradient(circle at 20% 30%, rgba(16, 185, 129, 0.15) 0%, transparent 40%),
        radial-gradient(circle at 80% 70%, rgba(251, 191, 36, 0.1) 0%, transparent 40%);
    pointer-events: none;
}

.financing-process-content {
    position: relative;
    z-index: 2;
    max-width: 1100px;
    margin: 0 auto;
}

.financing-process-header {
    text-align: center;
    margin-bottom: 80px;
}

.financing-process h2 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2.2rem, 4vw, 2.8rem);
    color: var(--finance-white);
    margin-bottom: 18px;
}

.financing-process-description {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.8);
    max-width: 550px;
    margin: 0 auto;
}

.financing-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    position: relative;
}

.financing-steps::before {
    content: '';
    position: absolute;
    top: 50px;
    left: 12%;
    right: 12%;
    height: 3px;
    background: rgba(255, 255, 255, 0.2);
    z-index: 1;
}

.financing-step {
    text-align: center;
    position: relative;
    z-index: 2;
}

.financing-step-number {
    width: 100px;
    height: 100px;
    margin: 0 auto 25px;
    background: rgba(255, 255, 255, 0.1);
    border: 3px solid rgba(16, 185, 129, 0.5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Fraunces', serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--finance-mint-light);
    transition: all 0.4s ease;
}

.financing-step:hover .financing-step-number {
    background: var(--finance-mint);
    border-color: var(--finance-mint);
    color: var(--finance-white);
    transform: scale(1.1);
}

.financing-step h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.3rem;
    color: var(--finance-white);
    margin-bottom: 12px;
}

.financing-step p {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
}

/* ═══════════════════════════════════════════════════════════════════════════
   CALCULATOR SECTION
   ═══════════════════════════════════════════════════════════════════════════ */

.financing-calculator {
    padding: 120px 5%;
    background: var(--finance-white);
}

.financing-calculator-container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
}

.financing-calculator-text h2 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2.2rem, 4vw, 2.8rem);
    color: var(--finance-slate);
    margin-bottom: 20px;
}

.financing-calculator-text h2 span {
    color: var(--finance-forest);
}

.financing-calculator-text p {
    font-size: 1.1rem;
    color: var(--finance-slate-light);
    line-height: 1.7;
    margin-bottom: 30px;
}

.financing-calculator-note {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    padding: 20px;
    background: var(--finance-soft-white);
    border-radius: 15px;
    border-left: 4px solid var(--finance-mint);
}

.financing-calculator-note i {
    color: var(--finance-mint);
    font-size: 1.2rem;
    margin-top: 2px;
}

.financing-calculator-note span {
    font-size: 0.95rem;
    color: var(--finance-slate-light);
    line-height: 1.6;
}

.financing-calculator-display {
    background: var(--finance-soft-white);
    border-radius: 24px;
    padding: 40px;
    position: relative;
}

.financing-calc-example {
    text-align: center;
}

.financing-calc-example-label {
    font-size: 0.9rem;
    color: var(--finance-slate-light);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 15px;
}

.financing-calc-example-amount {
    font-family: 'Fraunces', serif;
    font-size: 4rem;
    font-weight: 700;
    color: var(--finance-forest);
    line-height: 1;
    margin-bottom: 10px;
}

.financing-calc-example-period {
    font-size: 1.1rem;
    color: var(--finance-slate-light);
    margin-bottom: 30px;
}

.financing-calc-breakdown {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
