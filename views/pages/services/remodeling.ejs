<!-- Warm Transformation Design - Home Remodeling -->
<style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Source+Sans+3:wght@300;400;500;600;700&display=swap');

:root {
    --remodel-terracotta: #C4704F;
    --remodel-terracotta-dark: #A85A3B;
    --remodel-amber: #D4A84B;
    --remodel-amber-light: #E8C77B;
    --remodel-brown-deep: #3D2B1F;
    --remodel-brown-rich: #5C4033;
    --remodel-cream: #F7F3ED;
    --remodel-cream-dark: #EDE5D8;
    --remodel-charcoal: #2A2A2A;
    --remodel-warm-white: #FFFAF5;
    --remodel-gold: #B8860B;
}

/* ===== HERO SECTION ===== */
.remodel-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--remodel-brown-deep);
}

.remodel-hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/services/remodeling.jpg');
    background-size: cover;
    background-position: center;
    animation: heroZoom 25s ease-out forwards;
    transform-origin: center;
}

@keyframes heroZoom {
    from { transform: scale(1.15); }
    to { transform: scale(1); }
}

.remodel-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        135deg,
        rgba(61, 43, 31, 0.92) 0%,
        rgba(92, 64, 51, 0.85) 40%,
        rgba(196, 112, 79, 0.75) 100%
    );
}

.remodel-hero-texture {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    opacity: 0.03;
    pointer-events: none;
}

/* Decorative corner accent */
.remodel-hero-accent {
    position: absolute;
    top: 0;
    right: 0;
    width: 40%;
    height: 100%;
    background: linear-gradient(
        -45deg,
        rgba(212, 168, 75, 0.15) 0%,
        transparent 60%
    );
    pointer-events: none;
}

.remodel-hero-content {
    position: relative;
    z-index: 10;
    max-width: 1400px;
    margin: 0 auto;
    padding: 120px 2rem 80px;
    width: 100%;
}

.remodel-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(212, 168, 75, 0.15);
    border: 1px solid rgba(212, 168, 75, 0.4);
    padding: 0.6rem 1.25rem;
    border-radius: 50px;
    margin-bottom: 2rem;
    animation: fadeSlideUp 0.8s ease-out 0.2s both;
}

.remodel-hero-badge-icon {
    width: 20px;
    height: 20px;
    background: var(--remodel-amber);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.remodel-hero-badge-icon i {
    font-size: 0.65rem;
    color: var(--remodel-brown-deep);
}

.remodel-hero-badge span {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--remodel-amber-light);
    text-transform: uppercase;
    letter-spacing: 2px;
}

.remodel-hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 500;
    color: var(--remodel-warm-white);
    line-height: 1.1;
    margin-bottom: 1.5rem;
    animation: fadeSlideUp 0.8s ease-out 0.4s both;
}

.remodel-hero-title em {
    font-style: italic;
    color: var(--remodel-amber);
}

.remodel-hero-subtitle {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 1.35rem;
    font-weight: 300;
    color: rgba(255, 250, 245, 0.85);
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: 2.5rem;
    animation: fadeSlideUp 0.8s ease-out 0.6s both;
}

.remodel-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 4rem;
    animation: fadeSlideUp 0.8s ease-out 0.8s both;
}

.remodel-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, var(--remodel-terracotta) 0%, var(--remodel-terracotta-dark) 100%);
    color: white;
    padding: 1.1rem 2rem;
    border-radius: 8px;
    font-family: 'Source Sans 3', sans-serif;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 20px rgba(196, 112, 79, 0.4);
    position: relative;
    overflow: hidden;
}

.remodel-btn-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--remodel-amber) 0%, var(--remodel-terracotta) 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
}

.remodel-btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(196, 112, 79, 0.5);
}

.remodel-btn-primary:hover::before {
    opacity: 1;
}

.remodel-btn-primary span,
.remodel-btn-primary i {
    position: relative;
    z-index: 1;
}

.remodel-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: transparent;
    color: var(--remodel-cream);
    padding: 1.1rem 2rem;
    border-radius: 8px;
    font-family: 'Source Sans 3', sans-serif;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    border: 2px solid rgba(247, 243, 237, 0.3);
    transition: all 0.3s ease;
}

.remodel-btn-secondary:hover {
    background: rgba(247, 243, 237, 0.1);
    border-color: rgba(247, 243, 237, 0.5);
    transform: translateY(-2px);
}

/* Hero Stats */
.remodel-hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 700px;
    animation: fadeSlideUp 0.8s ease-out 1s both;
}

.remodel-stat {
    text-align: left;
    padding-left: 1.5rem;
    border-left: 2px solid rgba(212, 168, 75, 0.4);
}

.remodel-stat-number {
    font-family: 'Playfair Display', serif;
    font-size: 2.75rem;
    font-weight: 600;
    color: var(--remodel-amber);
    line-height: 1;
    margin-bottom: 0.5rem;
}

.remodel-stat-label {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(255, 250, 245, 0.7);
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Scroll indicator */
.remodel-scroll-indicator {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    animation: fadeIn 1s ease-out 1.5s both;
}

.remodel-scroll-indicator span {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255, 250, 245, 0.5);
    text-transform: uppercase;
    letter-spacing: 2px;
}

.remodel-scroll-line {
    width: 1px;
    height: 50px;
    background: linear-gradient(to bottom, var(--remodel-amber), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
}

@keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(0.7); }
    50% { opacity: 1; transform: scaleY(1); }
}

/* ===== INTRO SECTION ===== */
.remodel-intro {
    background: var(--remodel-warm-white);
    padding: 6rem 2rem;
    position: relative;
}

.remodel-intro-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    align-items: center;
}

.remodel-intro-content h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2.75rem;
    font-weight: 500;
    color: var(--remodel-brown-deep);
    line-height: 1.2;
    margin-bottom: 1.5rem;
}

.remodel-intro-content h2 span {
    color: var(--remodel-terracotta);
}

.remodel-intro-content p {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--remodel-brown-rich);
    line-height: 1.8;
    margin-bottom: 2rem;
}

.remodel-intro-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
}

.remodel-intro-feature {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.remodel-intro-feature i {
    width: 28px;
    height: 28px;
    background: linear-gradient(135deg, var(--remodel-terracotta), var(--remodel-amber));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 0.7rem;
}

.remodel-intro-feature span {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--remodel-brown-deep);
}

.remodel-intro-image {
    position: relative;
}

.remodel-intro-image-main {
    width: 100%;
    height: 450px;
    object-fit: cover;
    border-radius: 16px;
    box-shadow: 0 25px 60px rgba(61, 43, 31, 0.2);
}

.remodel-intro-image-accent {
    position: absolute;
    bottom: -30px;
    left: -30px;
    width: 200px;
    height: 200px;
    background: linear-gradient(135deg, var(--remodel-amber) 0%, var(--remodel-terracotta) 100%);
    border-radius: 16px;
    z-index: -1;
    opacity: 0.3;
}

/* ===== SERVICES SECTION ===== */
.remodel-services {
    background: var(--remodel-cream);
    padding: 6rem 2rem;
    position: relative;
}

.remodel-services::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--remodel-terracotta), transparent);
}

.remodel-services-container {
    max-width: 1300px;
    margin: 0 auto;
}

.remodel-section-header {
    text-align: center;
    margin-bottom: 4rem;
}

.remodel-section-tag {
    display: inline-block;
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--remodel-terracotta);
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 1rem;
}

.remodel-section-title {
    font-family: 'Playfair Display', serif;
    font-size: 2.75rem;
    font-weight: 500;
    color: var(--remodel-brown-deep);
    line-height: 1.2;
}

.remodel-section-title em {
    font-style: italic;
    color: var(--remodel-terracotta);
}

.remodel-services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 1.5rem;
}

.remodel-service-card {
    background: var(--remodel-warm-white);
    border-radius: 16px;
    padding: 2rem;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid rgba(61, 43, 31, 0.08);
}

.remodel-service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 0;
    background: linear-gradient(to bottom, var(--remodel-terracotta), var(--remodel-amber));
    transition: height 0.4s ease;
}

.remodel-service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 50px rgba(61, 43, 31, 0.15);
}

.remodel-service-card:hover::before {
    height: 100%;
}

/* Featured card - Kitchen */
.remodel-service-card.featured {
    grid-column: 1;
    grid-row: 1 / 3;
    background: linear-gradient(165deg, var(--remodel-brown-deep) 0%, var(--remodel-brown-rich) 100%);
    padding: 2.5rem;
}

.remodel-service-card.featured::before {
    display: none;
}

.remodel-service-card.featured .remodel-service-icon {
    background: linear-gradient(135deg, var(--remodel-amber) 0%, var(--remodel-terracotta) 100%);
    color: var(--remodel-brown-deep);
}

.remodel-service-card.featured .remodel-service-title {
    color: var(--remodel-warm-white);
    font-size: 1.75rem;
}

.remodel-service-card.featured .remodel-service-desc {
    color: rgba(255, 250, 245, 0.8);
    font-size: 1.05rem;
}

.remodel-service-card.featured .remodel-service-features li {
    color: rgba(255, 250, 245, 0.7);
}

.remodel-service-card.featured .remodel-service-features li::before {
    background: var(--remodel-amber);
}

.remodel-service-icon {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, rgba(196, 112, 79, 0.1) 0%, rgba(212, 168, 75, 0.1) 100%);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    transition: all 0.3s ease;
}

.remodel-service-card:hover .remodel-service-icon {
    background: linear-gradient(135deg, var(--remodel-terracotta) 0%, var(--remodel-amber) 100%);
}

.remodel-service-card:hover .remodel-service-icon i {
    color: white;
}

.remodel-service-icon i {
    font-size: 1.5rem;
    color: var(--remodel-terracotta);
    transition: color 0.3s ease;
}

.remodel-service-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--remodel-brown-deep);
    margin-bottom: 0.75rem;
}

.remodel-service-desc {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.95rem;
    color: var(--remodel-brown-rich);
    line-height: 1.6;
    margin-bottom: 1.25rem;
}

.remodel-service-features {
    list-style: none;
    padding: 0;
    margin: 0;
}

.remodel-service-features li {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.85rem;
    color: rgba(61, 43, 31, 0.7);
    padding: 0.4rem 0;
    padding-left: 1.25rem;
    position: relative;
}

.remodel-service-features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    background: var(--remodel-terracotta);
    border-radius: 50%;
}

/* ===== PROCESS SECTION ===== */
.remodel-process {
    background: var(--remodel-warm-white);
    padding: 6rem 2rem;
    position: relative;
    overflow: hidden;
}

.remodel-process-container {
    max-width: 1200px;
    margin: 0 auto;
}

.remodel-process-timeline {
    position: relative;
    padding: 3rem 0;
}

/* Connecting line */
.remodel-process-line {
    position: absolute;
    top: 50%;
    left: 10%;
    right: 10%;
    height: 2px;
    background: var(--remodel-cream-dark);
    transform: translateY(-50%);
    z-index: 1;
}

.remodel-process-line-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--remodel-terracotta), var(--remodel-amber));
    transition: width 1.5s ease-out;
}

.remodel-process-line-fill.animate {
    width: 100%;
}

.remodel-process-steps {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    position: relative;
    z-index: 2;
}

.remodel-process-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.5s ease;
}

.remodel-process-step.animate {
    opacity: 1;
    transform: translateY(0);
}

.remodel-process-step:nth-child(1) { transition-delay: 0.1s; }
.remodel-process-step:nth-child(2) { transition-delay: 0.3s; }
.remodel-process-step:nth-child(3) { transition-delay: 0.5s; }
.remodel-process-step:nth-child(4) { transition-delay: 0.7s; }
.remodel-process-step:nth-child(5) { transition-delay: 0.9s; }

.remodel-step-number {
    width: 70px;
    height: 70px;
    background: var(--remodel-warm-white);
    border: 3px solid var(--remodel-cream-dark);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    transition: all 0.4s ease;
    position: relative;
}

.remodel-process-step.animate .remodel-step-number {
    border-color: var(--remodel-terracotta);
    background: linear-gradient(135deg, var(--remodel-terracotta) 0%, var(--remodel-amber) 100%);
}

.remodel-step-number span {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--remodel-brown-rich);
    transition: color 0.4s ease;
}

.remodel-process-step.animate .remodel-step-number span {
    color: white;
}

.remodel-step-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--remodel-brown-deep);
    margin-bottom: 0.5rem;
}

.remodel-step-desc {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.85rem;
    color: var(--remodel-brown-rich);
    line-height: 1.5;
    max-width: 160px;
}

/* ===== SHOWCASE SECTION ===== */
.remodel-showcase {
    background: linear-gradient(165deg, var(--remodel-brown-deep) 0%, #2a1f17 100%);
    padding: 6rem 2rem;
    position: relative;
    overflow: hidden;
}

.remodel-showcase::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    opacity: 0.04;
    pointer-events: none;
}

.remodel-showcase-container {
    max-width: 1300px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
}

.remodel-showcase .remodel-section-header {
    margin-bottom: 3rem;
}

.remodel-showcase .remodel-section-tag {
    color: var(--remodel-amber);
}

.remodel-showcase .remodel-section-title {
    color: var(--remodel-warm-white);
}

.remodel-showcase-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
}

.remodel-showcase-item {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4/5;
    cursor: pointer;
    group: true;
}

.remodel-showcase-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.remodel-showcase-item:hover img {
    transform: scale(1.08);
}

.remodel-showcase-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to top,
        rgba(61, 43, 31, 0.95) 0%,
        rgba(61, 43, 31, 0.4) 40%,
        transparent 100%
    );
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.75rem;
    opacity: 0;
    transition: opacity 0.4s ease;
}

.remodel-showcase-item:hover .remodel-showcase-overlay {
    opacity: 1;
}

.remodel-showcase-label {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--remodel-amber);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 0.5rem;
}

.remodel-showcase-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--remodel-warm-white);
    margin-bottom: 0.5rem;
}

.remodel-showcase-location {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.85rem;
    color: rgba(255, 250, 245, 0.7);
}

/* ===== BENEFITS SECTION ===== */
.remodel-benefits {
    background: linear-gradient(135deg, var(--remodel-cream) 0%, var(--remodel-cream-dark) 100%);
    padding: 6rem 2rem;
    position: relative;
}

.remodel-benefits-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
}

.remodel-benefits-content h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem;
    font-weight: 500;
    color: var(--remodel-brown-deep);
    line-height: 1.2;
    margin-bottom: 1.5rem;
}

.remodel-benefits-content h2 em {
    font-style: italic;
    color: var(--remodel-terracotta);
}

.remodel-benefits-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.remodel-benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--remodel-warm-white);
    border-radius: 12px;
    transition: all 0.3s ease;
    border: 1px solid transparent;
}

.remodel-benefit-item:hover {
    border-color: rgba(196, 112, 79, 0.2);
    transform: translateX(8px);
}

.remodel-benefit-icon {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, var(--remodel-terracotta) 0%, var(--remodel-amber) 100%);
    border-radius: 10px;
    display: flex;
    align-items: center;
