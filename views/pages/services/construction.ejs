<!-- Blueprint Precision Design - New Construction -->
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Work+Sans:wght@300;400;500;600;700&display=swap');

:root {
    --build-navy: #0A1628;
    --build-navy-light: #132238;
    --build-steel: #1E3A5F;
    --build-cyan: #00A8E8;
    --build-cyan-light: #4FC3F7;
    --build-slate: #E8EEF4;
    --build-slate-dark: #C5D3E0;
    --build-white: #FFFFFF;
    --build-orange: #FF6B35;
    --build-orange-dark: #E55A2B;
    --build-gray: #64748B;
}

/* ===== HERO SECTION ===== */
.build-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--build-navy);
}

.build-hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/projects/anderson-hero.jpg');
    background-size: cover;
    background-position: center;
    opacity: 0.4;
    animation: heroScale 20s ease-out forwards;
}

@keyframes heroScale {
    from { transform: scale(1.1); }
    to { transform: scale(1); }
}

/* Blueprint Grid Overlay */
.build-hero-grid {
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(rgba(0, 168, 232, 0.1) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 168, 232, 0.1) 1px, transparent 1px);
    background-size: 50px 50px;
    animation: gridPulse 4s ease-in-out infinite;
}

@keyframes gridPulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.6; }
}

.build-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        135deg,
        rgba(10, 22, 40, 0.95) 0%,
        rgba(30, 58, 95, 0.85) 50%,
        rgba(10, 22, 40, 0.9) 100%
    );
}

/* Blueprint corner marks */
.build-hero-marks {
    position: absolute;
    inset: 2rem;
    pointer-events: none;
}

.build-hero-marks::before,
.build-hero-marks::after {
    content: '';
    position: absolute;
    width: 60px;
    height: 60px;
    border: 2px solid rgba(0, 168, 232, 0.3);
}

.build-hero-marks::before {
    top: 0;
    left: 0;
    border-right: none;
    border-bottom: none;
}

.build-hero-marks::after {
    bottom: 0;
    right: 0;
    border-left: none;
    border-top: none;
}

.build-hero-content {
    position: relative;
    z-index: 10;
    max-width: 1400px;
    margin: 0 auto;
    padding: 120px 2rem 80px;
    width: 100%;
}

.build-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(0, 168, 232, 0.1);
    border: 1px solid rgba(0, 168, 232, 0.3);
    padding: 0.6rem 1.25rem;
    border-radius: 4px;
    margin-bottom: 2rem;
    animation: fadeSlideUp 0.8s ease-out 0.2s both;
}

.build-hero-badge-line {
    width: 24px;
    height: 2px;
    background: var(--build-cyan);
}

.build-hero-badge span {
    font-family: 'Work Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--build-cyan);
    text-transform: uppercase;
    letter-spacing: 3px;
}

.build-hero-title {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(2.75rem, 6vw, 5rem);
    font-weight: 700;
    color: var(--build-white);
    line-height: 1.1;
    margin-bottom: 1.5rem;
    animation: fadeSlideUp 0.8s ease-out 0.4s both;
}

.build-hero-title span {
    color: var(--build-cyan);
}

.build-hero-subtitle {
    font-family: 'Work Sans', sans-serif;
    font-size: 1.25rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.8);
    max-width: 550px;
    line-height: 1.7;
    margin-bottom: 2.5rem;
    animation: fadeSlideUp 0.8s ease-out 0.6s both;
}

.build-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 4rem;
    animation: fadeSlideUp 0.8s ease-out 0.8s both;
}

.build-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--build-orange);
    color: white;
    padding: 1rem 2rem;
    border-radius: 4px;
    font-family: 'Work Sans', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(255, 107, 53, 0.3);
}

.build-btn-primary:hover {
    background: var(--build-orange-dark);
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(255, 107, 53, 0.4);
}

.build-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: transparent;
    color: var(--build-white);
    padding: 1rem 2rem;
    border-radius: 4px;
    font-family: 'Work Sans', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border: 2px solid rgba(255, 255, 255, 0.3);
    transition: all 0.3s ease;
}

.build-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
}

/* Hero Stats */
.build-hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 650px;
    animation: fadeSlideUp 0.8s ease-out 1s both;
}

.build-stat {
    position: relative;
    padding-left: 1rem;
}

.build-stat::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(to bottom, var(--build-cyan), transparent);
}

.build-stat-number {
    font-family: 'DM Sans', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--build-cyan);
    line-height: 1;
    margin-bottom: 0.5rem;
}

.build-stat-label {
    font-family: 'Work Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* ===== INTRO SECTION ===== */
.build-intro {
    background: var(--build-white);
    padding: 6rem 2rem;
    position: relative;
}

.build-intro-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
}

.build-intro-content h2 {
    font-family: 'DM Sans', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--build-navy);
    line-height: 1.2;
    margin-bottom: 1.5rem;
}

.build-intro-content h2 span {
    color: var(--build-cyan);
}

.build-intro-content p {
    font-family: 'Work Sans', sans-serif;
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--build-gray);
    line-height: 1.8;
    margin-bottom: 2rem;
}

.build-intro-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
}

.build-intro-feature {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.build-intro-feature i {
    width: 24px;
    height: 24px;
    background: var(--build-cyan);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 0.65rem;
}

.build-intro-feature span {
    font-family: 'Work Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--build-navy);
}

.build-intro-image {
    position: relative;
}

.build-intro-image img {
    width: 100%;
    height: 400px;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: 0 20px 50px rgba(10, 22, 40, 0.2);
}

.build-intro-image-frame {
    position: absolute;
    top: -15px;
    right: -15px;
    width: 100%;
    height: 100%;
    border: 2px solid var(--build-cyan);
    border-radius: 8px;
    z-index: -1;
}

/* ===== SERVICES SECTION ===== */
.build-services {
    background: var(--build-slate);
    padding: 6rem 2rem;
    position: relative;
}

.build-services-container {
    max-width: 1300px;
    margin: 0 auto;
}

.build-section-header {
    text-align: center;
    margin-bottom: 4rem;
}

.build-section-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: 'Work Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--build-cyan);
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 1rem;
}

.build-section-tag::before,
.build-section-tag::after {
    content: '';
    width: 30px;
    height: 1px;
    background: var(--build-cyan);
}

.build-section-title {
    font-family: 'DM Sans', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--build-navy);
    line-height: 1.2;
}

.build-services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 1.5rem;
}

.build-service-card {
    background: var(--build-white);
    border-radius: 8px;
    padding: 2rem;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid rgba(30, 58, 95, 0.1);
}

.build-service-card::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--build-cyan), var(--build-orange));
    transform: scaleX(0);
    transition: transform 0.4s ease;
}

.build-service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 50px rgba(10, 22, 40, 0.15);
}

.build-service-card:hover::after {
    transform: scaleX(1);
}

/* Featured card - Custom Homes */
.build-service-card.featured {
    grid-column: 1;
    grid-row: 1 / 3;
    background: linear-gradient(165deg, var(--build-navy) 0%, var(--build-steel) 100%);
    padding: 2.5rem;
}

.build-service-card.featured::after {
    display: none;
}

.build-service-card.featured .build-service-icon {
    background: var(--build-cyan);
    color: var(--build-navy);
}

.build-service-card.featured .build-service-title {
    color: var(--build-white);
    font-size: 1.6rem;
}

.build-service-card.featured .build-service-desc {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1rem;
}

.build-service-card.featured .build-service-features li {
    color: rgba(255, 255, 255, 0.7);
}

.build-service-card.featured .build-service-features li::before {
    background: var(--build-cyan);
}

.build-service-icon {
    width: 52px;
    height: 52px;
    background: rgba(0, 168, 232, 0.1);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    transition: all 0.3s ease;
}

.build-service-card:hover .build-service-icon {
    background: var(--build-cyan);
}

.build-service-card:hover .build-service-icon i {
    color: white;
}

.build-service-icon i {
    font-size: 1.4rem;
    color: var(--build-cyan);
    transition: color 0.3s ease;
}

.build-service-title {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--build-navy);
    margin-bottom: 0.75rem;
}

.build-service-desc {
    font-family: 'Work Sans', sans-serif;
    font-size: 0.9rem;
    color: var(--build-gray);
    line-height: 1.6;
    margin-bottom: 1rem;
}

.build-service-features {
    list-style: none;
    padding: 0;
    margin: 0;
}

.build-service-features li {
    font-family: 'Work Sans', sans-serif;
    font-size: 0.85rem;
    color: var(--build-gray);
    padding: 0.35rem 0;
    padding-left: 1.25rem;
    position: relative;
}

.build-service-features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    background: var(--build-cyan);
    border-radius: 2px;
}

/* ===== PROCESS SECTION ===== */
.build-process {
    background: var(--build-white);
    padding: 6rem 2rem;
    position: relative;
    overflow: hidden;
}

/* Blueprint background pattern */
.build-process::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(rgba(0, 168, 232, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 168, 232, 0.03) 1px, transparent 1px);
    background-size: 30px 30px;
    pointer-events: none;
}

.build-process-container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
}

.build-process-timeline {
    position: relative;
    padding: 3rem 0;
}

/* Blueprint-style connecting line */
.build-process-line {
    position: absolute;
    top: 50%;
    left: 8%;
    right: 8%;
    height: 2px;
    background: var(--build-slate-dark);
    transform: translateY(-50%);
    z-index: 1;
}

.build-process-line::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0;
    background: var(--build-cyan);
    transition: width 1.5s ease-out;
}

.build-process-line.animate::before {
    width: 100%;
}

/* Measurement marks */
.build-process-line::after {
    content: '';
    position: absolute;
    top: -4px;
    left: 0;
    right: 0;
    height: 10px;
    background-image: repeating-linear-gradient(
        90deg,
        var(--build-slate-dark) 0,
        var(--build-slate-dark) 1px,
        transparent 1px,
        transparent 20px
    );
}

.build-process-steps {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    position: relative;
    z-index: 2;
}

.build-process-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.5s ease;
}

.build-process-step.animate {
    opacity: 1;
    transform: translateY(0);
}

.build-process-step:nth-child(1) { transition-delay: 0.1s; }
.build-process-step:nth-child(2) { transition-delay: 0.3s; }
.build-process-step:nth-child(3) { transition-delay: 0.5s; }
.build-process-step:nth-child(4) { transition-delay: 0.7s; }
.build-process-step:nth-child(5) { transition-delay: 0.9s; }

.build-step-number {
    width: 64px;
    height: 64px;
    background: var(--build-white);
    border: 2px solid var(--build-slate-dark);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    transition: all 0.4s ease;
    position: relative;
}

.build-process-step.animate .build-step-number {
    border-color: var(--build-cyan);
    background: var(--build-cyan);
}

.build-step-number span {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--build-gray);
    transition: color 0.4s ease;
}

.build-process-step.animate .build-step-number span {
    color: white;
}

.build-step-title {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--build-navy);
    margin-bottom: 0.5rem;
}

.build-step-desc {
    font-family: 'Work Sans', sans-serif;
    font-size: 0.8rem;
    color: var(--build-gray);
    line-height: 1.5;
    max-width: 150px;
}

/* ===== FEATURED PROJECT SECTION ===== */
.build-featured {
    background: linear-gradient(165deg, var(--build-navy) 0%, var(--build-navy-light) 100%);
    padding: 6rem 2rem;
    position: relative;
    overflow: hidden;
}

.build-featured::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(rgba(0, 168, 232, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 168, 232, 0.05) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
}

.build-featured-container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
}

.build-featured .build-section-header {
    margin-bottom: 3rem;
}

.build-featured .build-section-title {
    color: var(--build-white);
}

.build-featured-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
}

.build-featured-info h3 {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--build-white);
    margin-bottom: 1rem;
}

.build-featured-info h3 span {
    color: var(--build-cyan);
}

.build-featured-info p {
    font-family: 'Work Sans', sans-serif;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    margin-bottom: 1.5rem;
}

.build-featured-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
}

.build-featured-list li {
    font-family: 'Work Sans', sans-serif;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.build-featured-list li i {
    color: var(--build-cyan);
    font-size: 0.75rem;
}

.build-featured-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
}

.build-featured-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1.5rem;
    border-radius: 6px;
    font-family: 'Work Sans', sans-serif;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.3s ease;
}

.build-featured-link.vr {
    background: var(--build-cyan);
    color: var(--build-navy);
}

.build-featured-link.vr:hover {
    background: var(--build-cyan-light);
    transform: translateY(-2px);
}

.build-featured-link.listing {
    background: transparent;
    color: var(--build-white);
    border: 2px solid rgba(255, 255, 255, 0.3);
}

.build-featured-link.listing:hover {
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.1);
}

.build-featured-image {
    position: relative;
}

.build-featured-image img {
    width: 100%;
    height: 400px;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3);
}

.build-featured-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    background: var(--build-orange);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-family: 'Work Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* ===== SHOWCASE SECTION ===== */
.build-showcase {
    background: var(--build-slate);
    padding: 6rem 2rem;
}

.build-showcase-container {
    max-width: 1300px;
    margin: 0 auto;
}

.build-showcase-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
}

.build-showcase-item {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16/10;
}

.build-showcase-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.build-showcase-item:hover img {
    transform: scale(1.05);
}

.build-showcase-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to top,
        rgba(10, 22, 40, 0.95) 0%,
        rgba(10, 22, 40, 0.3) 50%,
        transparent 100%
    );
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem;
    opacity: 0;
    transition: opacity 0.4s ease;
}

.build-showcase-item:hover .build-showcase-overlay {
    opacity: 1;
}

.build-showcase-tag {
    font-family: 'Work Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--build-cyan);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 0.5rem;
}

.build-showcase-title {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--build-white);
    margin-bottom: 0.5rem;
}

.build-showcase-desc {
    font-family: 'Work Sans', sans-serif;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
}

/* ===== BENEFITS SECTION ===== */
.build-benefits {
    background: var(--build-white);
    padding: 6rem 2rem;
}

.build-benefits-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
}

.build-benefits-image {
    position: relative;
}

.build-benefits-image img {
    width: 100%;
    height: 450px;
    object-fit: cover;
    border-radius: 8px;
