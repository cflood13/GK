<!-- Emergency Services Page - "Urgent Response" Aesthetic -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    /* ========================================
       URGENT RESPONSE - Emergency Aesthetic
       Bold reds, pulsing alerts, rapid action
    ======================================== */

    :root {
        --emergency-red: #DC2626;
        --emergency-red-dark: #B91C1C;
        --emergency-red-glow: rgba(220, 38, 38, 0.4);
        --urgent-orange: #F97316;
        --urgent-orange-dark: #EA580C;
        --urgent-amber: #FBBF24;
        --charcoal: #1C1917;
        --charcoal-light: #292524;
        --charcoal-lighter: #44403C;
        --smoke: #78716C;
        --ash: #A8A29E;
        --white: #FAFAF9;
        --cream: #F5F5F4;

        --font-display: 'Oswald', sans-serif;
        --font-body: 'Source Sans 3', sans-serif;

        --shadow-urgent: 0 4px 30px rgba(220, 38, 38, 0.3);
        --shadow-card: 0 8px 40px rgba(0, 0, 0, 0.4);
    }

    /* ========================================
       Reset & Base
    ======================================== */

    .emergency-page * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .emergency-page {
        font-family: var(--font-body);
        background: var(--charcoal);
        color: var(--white);
        overflow-x: hidden;
    }

    .emergency-page h1,
    .emergency-page h2,
    .emergency-page h3,
    .emergency-page h4 {
        font-family: var(--font-display);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }

    /* ========================================
       Emergency Alert Banner
    ======================================== */

    .emergency-alert-banner {
        background: linear-gradient(90deg, var(--emergency-red) 0%, var(--urgent-orange) 50%, var(--emergency-red) 100%);
        background-size: 200% 100%;
        animation: alertPulse 2s ease-in-out infinite;
        padding: 12px 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        position: relative;
        overflow: hidden;
    }

    @keyframes alertPulse {
        0%, 100% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
    }

    .emergency-alert-banner::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
        animation: alertShine 3s ease-in-out infinite;
    }

    @keyframes alertShine {
        0% { left: -100%; }
        50%, 100% { left: 100%; }
    }

    .alert-icon {
        font-size: 1.2rem;
        animation: iconPulse 1s ease-in-out infinite;
    }

    @keyframes iconPulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.2); }
    }

    .alert-text {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .alert-phone {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--white);
        text-decoration: none;
        background: rgba(0,0,0,0.2);
        padding: 6px 16px;
        border-radius: 4px;
        transition: all 0.3s ease;
    }

    .alert-phone:hover {
        background: rgba(0,0,0,0.4);
        transform: scale(1.05);
    }

    /* ========================================
       Hero Section
    ======================================== */

    .emergency-hero {
        position: relative;
        min-height: 85vh;
        display: flex;
        align-items: center;
        overflow: hidden;
    }

    .emergency-hero-bg {
        position: absolute;
        inset: 0;
        background: url('/images/services/roofing-aerial.jpg') center center/cover no-repeat;
        transform: scale(1.1);
        animation: heroZoom 20s ease-in-out infinite alternate;
    }

    @keyframes heroZoom {
        0% { transform: scale(1.1); }
        100% { transform: scale(1.0); }
    }

    .emergency-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            135deg,
            rgba(28, 25, 23, 0.95) 0%,
            rgba(28, 25, 23, 0.8) 40%,
            rgba(220, 38, 38, 0.3) 100%
        );
    }

    .emergency-hero-pattern {
        position: absolute;
        inset: 0;
        background-image:
            repeating-linear-gradient(
                45deg,
                transparent,
                transparent 35px,
                rgba(220, 38, 38, 0.03) 35px,
                rgba(220, 38, 38, 0.03) 70px
            );
        animation: patternMove 30s linear infinite;
    }

    @keyframes patternMove {
        0% { background-position: 0 0; }
        100% { background-position: 100px 100px; }
    }

    .emergency-hero-content {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 40px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        align-items: center;
    }

    .hero-text {
        animation: slideInLeft 1s ease-out;
    }

    @keyframes slideInLeft {
        from {
            opacity: 0;
            transform: translateX(-60px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .emergency-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--emergency-red);
        color: var(--white);
        padding: 10px 20px;
        font-family: var(--font-display);
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        margin-bottom: 25px;
        position: relative;
        overflow: hidden;
        animation: badgePulse 2s ease-in-out infinite;
    }

    @keyframes badgePulse {
        0%, 100% { box-shadow: 0 0 0 0 var(--emergency-red-glow); }
        50% { box-shadow: 0 0 0 10px transparent; }
    }

    .emergency-badge i {
        animation: iconPulse 1s ease-in-out infinite;
    }

    .hero-title {
        font-size: clamp(3rem, 6vw, 5rem);
        line-height: 1.05;
        color: var(--white);
        margin-bottom: 20px;
    }

    .hero-title .highlight {
        color: var(--emergency-red);
        position: relative;
        display: inline-block;
    }

    .hero-title .highlight::after {
        content: '';
        position: absolute;
        bottom: 5px;
        left: 0;
        width: 100%;
        height: 8px;
        background: var(--urgent-orange);
        opacity: 0.6;
        z-index: -1;
    }

    .hero-subtitle {
        font-size: 1.3rem;
        color: var(--ash);
        line-height: 1.7;
        margin-bottom: 35px;
        max-width: 540px;
    }

    .hero-actions {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .btn-emergency {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 18px 35px;
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .btn-emergency.primary {
        background: var(--emergency-red);
        color: var(--white);
        box-shadow: var(--shadow-urgent);
    }

    .btn-emergency.primary::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
        transition: left 0.5s ease;
    }

    .btn-emergency.primary:hover::before {
        left: 100%;
    }

    .btn-emergency.primary:hover {
        background: var(--emergency-red-dark);
        transform: translateY(-3px);
        box-shadow: 0 8px 40px rgba(220, 38, 38, 0.5);
    }

    .btn-emergency.secondary {
        background: transparent;
        color: var(--white);
        border: 2px solid var(--charcoal-lighter);
    }

    .btn-emergency.secondary:hover {
        border-color: var(--urgent-orange);
        color: var(--urgent-orange);
        transform: translateY(-3px);
    }

    /* Hero Stats */
    .hero-stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 25px;
        animation: slideInRight 1s ease-out 0.3s both;
    }

    @keyframes slideInRight {
        from {
            opacity: 0;
            transform: translateX(60px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .stat-card {
        background: rgba(28, 25, 23, 0.9);
        border: 1px solid var(--charcoal-lighter);
        padding: 30px;
        position: relative;
        overflow: hidden;
        transition: all 0.4s ease;
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: var(--emergency-red);
        transition: width 0.3s ease;
    }

    .stat-card:hover::before {
        width: 100%;
        opacity: 0.1;
    }

    .stat-card.featured {
        grid-column: span 2;
        background: linear-gradient(135deg, var(--emergency-red) 0%, var(--urgent-orange) 100%);
        border: none;
    }

    .stat-card.featured::before {
        display: none;
    }

    .stat-card.featured .stat-number {
        color: var(--white);
    }

    .stat-card.featured .stat-label {
        color: rgba(255,255,255,0.9);
    }

    .stat-icon {
        font-size: 1.5rem;
        color: var(--emergency-red);
        margin-bottom: 15px;
    }

    .stat-card.featured .stat-icon {
        color: var(--white);
    }

    .stat-number {
        font-family: var(--font-display);
        font-size: 3rem;
        font-weight: 700;
        color: var(--white);
        line-height: 1;
        margin-bottom: 8px;
    }

    .stat-label {
        font-size: 0.95rem;
        color: var(--ash);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    /* ========================================
       Services Section
    ======================================== */

    .emergency-services {
        padding: 120px 40px;
        background: var(--charcoal);
        position: relative;
    }

    .emergency-services::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--charcoal-lighter), transparent);
    }

    .services-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .section-header {
        text-align: center;
        margin-bottom: 80px;
    }

    .section-tag {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--emergency-red);
        font-family: var(--font-display);
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        margin-bottom: 20px;
    }

    .section-tag::before,
    .section-tag::after {
        content: '';
        width: 40px;
        height: 2px;
        background: var(--emergency-red);
    }

    .section-title {
        font-size: clamp(2.5rem, 4vw, 3.5rem);
        color: var(--white);
        margin-bottom: 20px;
    }

    .section-subtitle {
        font-size: 1.15rem;
        color: var(--ash);
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.7;
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
    }

    .service-card {
        background: var(--charcoal-light);
        border: 1px solid var(--charcoal-lighter);
        padding: 40px;
        position: relative;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
    }

    .service-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, var(--emergency-red), var(--urgent-orange));
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.4s ease;
    }

    .service-card:hover::before {
        transform: scaleX(1);
    }

    .service-card::after {
        content: '';
        position: absolute;
        bottom: -100%;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(180deg, transparent, rgba(220, 38, 38, 0.1));
        transition: bottom 0.4s ease;
    }

    .service-card:hover::after {
        bottom: 0;
    }

    .service-card:hover {
        transform: translateY(-8px);
        border-color: var(--emergency-red);
        box-shadow: var(--shadow-urgent);
    }

    .service-icon-wrap {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, var(--emergency-red), var(--urgent-orange));
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 25px;
        position: relative;
        z-index: 1;
        clip-path: polygon(10% 0%, 100% 0%, 100% 90%, 90% 100%, 0% 100%, 0% 10%);
    }

    .service-icon-wrap i {
        font-size: 1.8rem;
        color: var(--white);
    }

    .service-card-title {
        font-size: 1.4rem;
        color: var(--white);
        margin-bottom: 15px;
        position: relative;
        z-index: 1;
    }

    .service-card-desc {
        font-size: 1rem;
        color: var(--ash);
        line-height: 1.7;
        margin-bottom: 20px;
        position: relative;
        z-index: 1;
    }

    .service-card-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--emergency-red);
        font-family: var(--font-display);
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        text-decoration: none;
        position: relative;
        z-index: 1;
        transition: all 0.3s ease;
    }

    .service-card-link i {
        transition: transform 0.3s ease;
    }

    .service-card:hover .service-card-link {
        color: var(--urgent-orange);
    }

    .service-card:hover .service-card-link i {
        transform: translateX(5px);
    }

    /* ========================================
       Process Section
    ======================================== */

    .emergency-process {
        padding: 120px 40px;
        background: linear-gradient(180deg, var(--charcoal) 0%, var(--charcoal-light) 100%);
        position: relative;
        overflow: hidden;
    }

    .process-bg-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-family: var(--font-display);
        font-size: clamp(8rem, 20vw, 20rem);
        font-weight: 700;
        color: var(--charcoal-light);
        text-transform: uppercase;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0.3;
    }

    .process-container {
        max-width: 1200px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }

    .process-timeline {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        margin-top: 80px;
        position: relative;
    }

    .process-timeline::before {
        content: '';
        position: absolute;
        top: 50px;
        left: 12.5%;
        right: 12.5%;
        height: 4px;
        background: var(--charcoal-lighter);
    }

    .process-timeline::after {
        content: '';
        position: absolute;
        top: 50px;
        left: 12.5%;
        width: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--emergency-red), var(--urgent-orange));
        animation: processLine 3s ease-out forwards;
        animation-delay: 0.5s;
    }

    @keyframes processLine {
        to { width: 75%; }
    }

    .process-step {
        text-align: center;
        position: relative;
        opacity: 0;
        transform: translateY(30px);
        animation: stepReveal 0.6s ease-out forwards;
    }

    .process-step:nth-child(1) { animation-delay: 0.2s; }
    .process-step:nth-child(2) { animation-delay: 0.4s; }
    .process-step:nth-child(3) { animation-delay: 0.6s; }
    .process-step:nth-child(4) { animation-delay: 0.8s; }

    @keyframes stepReveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .step-number {
        width: 100px;
        height: 100px;
        background: var(--charcoal);
        border: 4px solid var(--charcoal-lighter);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 30px;
        position: relative;
        transition: all 0.4s ease;
    }

    .step-number span {
        font-family: var(--font-display);
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--smoke);
        transition: all 0.4s ease;
    }

    .process-step:hover .step-number {
        border-color: var(--emergency-red);
        background: var(--emergency-red);
        transform: scale(1.1);
        box-shadow: 0 0 30px var(--emergency-red-glow);
    }

    .process-step:hover .step-number span {
        color: var(--white);
    }

    .step-title {
        font-size: 1.3rem;
        color: var(--white);
        margin-bottom: 12px;
    }

    .step-desc {
        font-size: 0.95rem;
        color: var(--ash);
        line-height: 1.6;
        max-width: 200px;
        margin: 0 auto;
    }

    .step-time {
        display: inline-block;
        margin-top: 15px;
        padding: 6px 14px;
        background: rgba(220, 38, 38, 0.2);
        color: var(--emergency-red);
        font-family: var(--font-display);
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    /* ========================================
       Trust Section
    ======================================== */

    .emergency-trust {
        padding: 100px 40px;
        background: var(--emergency-red);
        position: relative;
        overflow: hidden;
    }

    .emergency-trust::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
            repeating-linear-gradient(
                -45deg,
                transparent,
                transparent 10px,
                rgba(0,0,0,0.05) 10px,
                rgba(0,0,0,0.05) 20px
            );
    }

    .trust-container {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 40px;
        position: relative;
        z-index: 1;
    }

    .trust-item {
        text-align: center;
        padding: 30px;
        transition: all 0.3s ease;
    }

    .trust-item:hover {
        transform: translateY(-5px);
    }

    .trust-icon {
        width: 80px;
        height: 80px;
        background: rgba(255,255,255,0.15);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        transition: all 0.3s ease;
    }

    .trust-item:hover .trust-icon {
        background: var(--white);
    }

    .trust-icon i {
        font-size: 2rem;
        color: var(--white);
        transition: all 0.3s ease;
    }

    .trust-item:hover .trust-icon i {
        color: var(--emergency-red);
    }

    .trust-title {
        font-size: 1.3rem;
        color: var(--white);
        margin-bottom: 8px;
    }

    .trust-desc {
        font-size: 0.95rem;
        color: rgba(255,255,255,0.8);
    }

    /* ========================================
       Projects Showcase
    ======================================== */

    .emergency-projects {
        padding: 120px 40px;
        background: var(--charcoal);
    }

    .projects-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 40px;
        margin-top: 80px;
    }

    .project-card {
        position: relative;
        height: 450px;
        overflow: hidden;
        cursor: pointer;
    }

    .project-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: all 0.6s ease;
    }

    .project-card:hover img {
        transform: scale(1.1);
    }

    .project-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            180deg,
            transparent 0%,
            rgba(28, 25, 23, 0.4) 50%,
            rgba(28, 25, 23, 0.95) 100%
        );
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 40px;
        transition: all 0.4s ease;
    }

    .project-card:hover .project-overlay {
        background: linear-gradient(
            180deg,
            rgba(220, 38, 38, 0.2) 0%,
            rgba(28, 25, 23, 0.6) 50%,
            rgba(28, 25, 23, 0.98) 100%
        );
    }

    .project-tag {
        display: inline-block;
        padding: 6px 14px;
        background: var(--emergency-red);
        color: var(--white);
        font-family: var(--font-display);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        margin-bottom: 15px;
        width: fit-content;
    }

    .project-title {
        font-size: 1.8rem;
        color: var(--white);
        margin-bottom: 10px;
    }

    .project-desc {
        font-size: 1rem;
        color: var(--ash);
        line-height: 1.6;
        margin-bottom: 20px;
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        transition: all 0.4s ease;
    }

    .project-card:hover .project-desc {
        max-height: 100px;
        opacity: 1;
    }

    .project-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--emergency-red);
        font-family: var(--font-display);
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .project-link:hover {
        color: var(--urgent-orange);
    }

    .project-link i {
        transition: transform 0.3s ease;
    }

    .project-link:hover i {
        transform: translateX(5px);
    }

    /* ========================================
