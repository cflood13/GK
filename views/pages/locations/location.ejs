<section class="page-hero" style="background-image: url('/images/services/roofing-aerial.jpg');">
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content">
        <h1 class="animate-on-scroll"><%= city %> Roofing & Construction</h1>
        <p class="animate-on-scroll">GAF & Owens Corning certified roofing in <%= city %> with free estimates</p>
    </div>
</section>

<!-- Location Map Section -->
<section class="location-map-section">
    <div class="container">
        <div class="section-title animate-on-scroll">
            <h2>Serving <%= city %> & Central Texas</h2>
            <p>Click the card to explore our service area</p>
        </div>

        <div class="location-map-card" data-location="<%= city %>, TX" data-coordinates="<%= typeof coordinates !== 'undefined' ? coordinates : '30.5083° N, 97.8530° W' %>">
            <div class="location-map-inner">
                <!-- Grid pattern (collapsed) -->
                <div class="map-grid-pattern">
                    <svg width="100%" height="100%">
                        <defs>
                            <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
                                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="white" stroke-width="0.5" />
                            </pattern>
                        </defs>
                        <rect width="100%" height="100%" fill="url(#grid)" />
                    </svg>
                </div>

                <!-- Map visualization (expanded) -->
                <div class="map-visualization">
                    <div class="map-background"></div>

                    <!-- Roads -->
                    <div class="map-roads">
                        <svg width="100%" height="100%" preserveAspectRatio="none">
                            <line class="map-road main" x1="0%" y1="35%" x2="100%" y2="35%" />
                            <line class="map-road main" x1="0%" y1="65%" x2="100%" y2="65%" />
                            <line class="map-road secondary" x1="30%" y1="0%" x2="30%" y2="100%" />
                            <line class="map-road secondary" x1="70%" y1="0%" x2="70%" y2="100%" />
                            <line class="map-road secondary" x1="0%" y1="20%" x2="100%" y2="20%" />
                            <line class="map-road secondary" x1="0%" y1="50%" x2="100%" y2="50%" />
                            <line class="map-road secondary" x1="0%" y1="80%" x2="100%" y2="80%" />
                            <line class="map-road secondary" x1="15%" y1="0%" x2="15%" y2="100%" />
                            <line class="map-road secondary" x1="50%" y1="0%" x2="50%" y2="100%" />
                            <line class="map-road secondary" x1="85%" y1="0%" x2="85%" y2="100%" />
                        </svg>
                    </div>

                    <!-- Buildings -->
                    <div class="map-buildings">
                        <div class="map-building"></div>
                        <div class="map-building"></div>
                        <div class="map-building"></div>
                        <div class="map-building"></div>
                        <div class="map-building"></div>
                    </div>

                    <!-- Location Pin -->
                    <div class="map-pin">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" fill="#ff6600" />
                            <circle cx="12" cy="9" r="2.5" fill="white" />
                        </svg>
                    </div>

                    <!-- Fade overlay -->
                    <div class="map-fade"></div>
                </div>

                <!-- Content -->
                <div class="map-content">
                    <div class="map-top">
                        <div class="map-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21" />
                                <line x1="9" x2="9" y1="3" y2="18" />
                                <line x1="15" x2="15" y1="6" y2="21" />
                            </svg>
                        </div>
                        <div class="map-status">
                            <div class="status-dot"></div>
                            <span class="status-text">Serving</span>
                        </div>
                    </div>

                    <div class="map-bottom">
                        <h3 class="map-location-name"><%= city %>, TX</h3>
                        <p class="map-coordinates"><%= typeof coordinates !== 'undefined' ? coordinates : '30.5083° N, 97.8530° W' %></p>
                        <div class="map-underline"></div>
                    </div>
                </div>
            </div>
            <p class="map-hint">Click to expand</p>
        </div>

        <!-- Service Area Pills -->
        <div class="service-area-pills">
            <a href="/locations/leander" class="area-pill<%= city === 'Leander' ? ' active' : '' %>">Leander</a>
            <a href="/locations/liberty-hill" class="area-pill<%= city === 'Liberty Hill' ? ' active' : '' %>">Liberty Hill</a>
            <a href="/locations/georgetown" class="area-pill<%= city === 'Georgetown' ? ' active' : '' %>">Georgetown</a>
            <a href="/locations/cedar-park" class="area-pill<%= city === 'Cedar Park' ? ' active' : '' %>">Cedar Park</a>
            <a href="/locations/round-rock" class="area-pill<%= city === 'Round Rock' ? ' active' : '' %>">Round Rock</a>
            <a href="/locations/pflugerville" class="area-pill<%= city === 'Pflugerville' ? ' active' : '' %>">Pflugerville</a>
            <a href="/locations/jonestown" class="area-pill<%= city === 'Jonestown' ? ' active' : '' %>">Jonestown</a>
            <a href="/locations/lago-vista" class="area-pill<%= city === 'Lago Vista' ? ' active' : '' %>">Lago Vista</a>
            <a href="/locations/burnet" class="area-pill<%= city === 'Burnet' ? ' active' : '' %>">Burnet</a>
            <a href="/locations/lake-travis" class="area-pill<%= city === 'Lake Travis' ? ' active' : '' %>">Lake Travis</a>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-intro">
            <h2>Roofing Company in <%= city %></h2>
            <p class="lead">GK Homes and Roofing provides professional roof replacement, repairs, and maintenance for homeowners and businesses in <%= city %>. With 19+ years of experience and certifications from GAF and Owens Corning, we deliver durable, beautiful roofs backed by strong warranties.</p>
        </div>

        <div class="services-grid">
            <div class="service-card">
                <div class="service-image">
                    <img src="/images/projects/roof-aerial-1.jpg" alt="Roof Replacement <%= city %>">
                </div>
                <div class="service-content">
                    <h3>Roof Replacement</h3>
                    <p>Architectural shingles, Owens Corning TruDefinition® Duration®, metal roofing, and designer options.</p>
                    <ul>
                        <li>Free inspections & estimates</li>
                        <li>Storm damage specialists</li>
                        <li>Financing available</li>
                    </ul>
                    <a href="/contact/quote" class="btn btn-primary">Get Free Quote</a>
                </div>
            </div>

            <div class="service-card">
                <div class="service-image">
                    <img src="/images/projects/roof-aerial-2.jpg" alt="Roof Repair <%= city %>">
                </div>
                <div class="service-content">
                    <h3>Roof Repair</h3>
                    <p>Leak detection and repair, flashing, vents, valley repairs, and emergency service.</p>
                    <ul>
                        <li>Same/next-day scheduling</li>
                        <li>Insurance claim assistance</li>
                        <li>Workmanship warranty</li>
                    </ul>
                    <a href="/contact" class="btn btn-primary">Schedule Inspection</a>
                </div>
            </div>
        </div>

        <section class="section" style="padding-top: 0;">
            <div class="container">
                <div class="section-title">
                    <h2>Why Choose Us in <%= city %>?</h2>
                    <p>Trusted, certified, and local</p>
                </div>
                <div class="benefits-grid">
                    <div class="benefit-item">
                        <i class="fas fa-certificate"></i>
                        <h4>Certified Installers</h4>
                        <p>GAF & Owens Corning certified for quality and warranty eligibility.</p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-clock"></i>
                        <h4>19+ Years Experience</h4>
                        <p>Central Texas roofing and construction experts since 2017.</p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-shield-alt"></i>
                        <h4>Strong Warranties</h4>
                        <p>Manufacturer and workmanship coverage for peace of mind.</p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-handshake"></i>
                        <h4>Local & Reliable</h4>
                        <p>Responsive service, transparent pricing, and clean jobsites.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="section" style="background:#f8f9fa;">
            <div class="container">
                <div class="section-title">
                    <h2>Premium Roofing Materials</h2>
                    <p>GAF & Owens Corning certified products for lasting protection</p>
                </div>
                <div class="shingle-showcase" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 2rem;">
                    <div class="shingle-card" style="background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.1);">
                        <img src="/images/hero-aerial.jpg" alt="Premium GAF Roofing Installation" style="width: 100%; height: 220px; object-fit: cover;">
                        <div style="padding: 1.5rem;">
                            <h3 style="margin-bottom: 0.5rem; color: #1a1a1a;">GAF Timberline HDZ®</h3>
                            <p style="color: #666; margin-bottom: 1rem;">America's #1 selling shingle with LayerLock™ technology and StainGuard Plus™ protection.</p>
                            <ul style="list-style: none; padding: 0; margin: 0;">
                                <li style="padding: 0.25rem 0;"><i class="fas fa-check" style="color: #ff6600; margin-right: 8px;"></i>130 MPH Wind Warranty</li>
                                <li style="padding: 0.25rem 0;"><i class="fas fa-check" style="color: #ff6600; margin-right: 8px;"></i>Lifetime Limited Warranty</li>
                            </ul>
                        </div>
                    </div>
                    <div class="shingle-card" style="background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.1);">
                        <img src="/images/projects/lakedillon-roof.jpg" alt="Owens Corning Duration Shingles" style="width: 100%; height: 220px; object-fit: cover;">
                        <div style="padding: 1.5rem;">
                            <h3 style="margin-bottom: 0.5rem; color: #1a1a1a;">Owens Corning Duration®</h3>
                            <p style="color: #666; margin-bottom: 1rem;">TruDefinition® color technology with SureNail® strip for superior holding power.</p>
                            <ul style="list-style: none; padding: 0; margin: 0;">
                                <li style="padding: 0.25rem 0;"><i class="fas fa-check" style="color: #ff6600; margin-right: 8px;"></i>130 MPH Wind Resistance</li>
                                <li style="padding: 0.25rem 0;"><i class="fas fa-check" style="color: #ff6600; margin-right: 8px;"></i>Limited Lifetime Warranty</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div style="text-align: center; margin-top: 2rem;">
                    <a href="/contact/quote" class="btn btn-primary">Get Your Free Estimate</a>
                </div>
            </div>
        </section>

        <section class="section cta-section">
            <div class="container">
                <div class="cta-content">
                    <h2>Need a Roofer in <%= city %>?</h2>
                    <p>Call 512-564-3679 or request a free estimate today</p>
                    <a href="/contact/quote" class="btn btn-primary">Free Estimate</a>
                </div>
            </div>
        </section>
    </div>
</section>
