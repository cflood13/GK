<!-- About Page - "Craftsman's Legacy" Aesthetic -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Nunito+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    /* ========================================
       CRAFTSMAN'S LEGACY - Editorial Warmth
       Earth tones, refined typography, heritage
    ======================================== */

    :root {
        --walnut: #5D4037;
        --walnut-dark: #4E342E;
        --walnut-light: #795548;
        --copper: #B87333;
        --copper-light: #CD8B4A;
        --copper-glow: rgba(184, 115, 51, 0.3);
        --sage: #6B705C;
        --sage-light: #8A9178;
        --cream: #FAF7F2;
        --cream-dark: #F5F0E8;
        --charcoal: #2C2C2C;
        --charcoal-light: #3D3D3D;
        --warm-gray: #A49E93;
        --warm-gray-light: #C4BEB3;

        --font-display: 'Cormorant Garamond', serif;
        --font-body: 'Nunito Sans', sans-serif;

        --shadow-soft: 0 4px 30px rgba(93, 64, 55, 0.1);
        --shadow-medium: 0 8px 40px rgba(93, 64, 55, 0.15);
        --shadow-strong: 0 12px 50px rgba(93, 64, 55, 0.2);
    }

    /* ========================================
       Reset & Base
    ======================================== */

    .about-page * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .about-page {
        font-family: var(--font-body);
        background: var(--cream);
        color: var(--charcoal);
        overflow-x: hidden;
    }

    .about-page h1,
    .about-page h2,
    .about-page h3,
    .about-page h4 {
        font-family: var(--font-display);
        font-weight: 600;
    }

    /* ========================================
       Hero Section
    ======================================== */

    .about-hero {
        position: relative;
        min-height: 90vh;
        display: flex;
        align-items: center;
        overflow: hidden;
    }

    .about-hero-bg {
        position: absolute;
        inset: 0;
        background: url('/images/about-us.jpg') center center/cover no-repeat;
        transform: scale(1.05);
        animation: heroBreath 20s ease-in-out infinite alternate;
    }

    @keyframes heroBreath {
        0% { transform: scale(1.05); }
        100% { transform: scale(1.0); }
    }

    .about-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            135deg,
            rgba(44, 44, 44, 0.85) 0%,
            rgba(93, 64, 55, 0.7) 50%,
            rgba(44, 44, 44, 0.8) 100%
        );
    }

    .about-hero-grain {
        position: absolute;
        inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
        opacity: 0.04;
        pointer-events: none;
    }

    .about-hero-content {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 40px;
        text-align: center;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 30px;
        padding: 12px 28px;
        background: rgba(184, 115, 51, 0.2);
        border: 1px solid var(--copper);
        color: var(--copper-light);
        font-family: var(--font-body);
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        animation: fadeInDown 1s ease-out;
    }

    @keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hero-title {
        font-size: clamp(3.5rem, 8vw, 6rem);
        font-weight: 500;
        color: var(--cream);
        line-height: 1.1;
        margin-bottom: 25px;
        animation: fadeInUp 1s ease-out 0.2s both;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hero-title em {
        font-style: italic;
        color: var(--copper-light);
    }

    .hero-subtitle {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 400;
        font-style: italic;
        color: var(--warm-gray-light);
        max-width: 600px;
        margin: 0 auto;
        animation: fadeInUp 1s ease-out 0.4s both;
    }

    .hero-scroll-indicator {
        position: absolute;
        bottom: 50px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        color: var(--warm-gray-light);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        animation: fadeInUp 1s ease-out 0.6s both;
    }

    .hero-scroll-indicator::after {
        content: '';
        width: 1px;
        height: 50px;
        background: linear-gradient(to bottom, var(--copper), transparent);
        animation: scrollPulse 2s ease-in-out infinite;
    }

    @keyframes scrollPulse {
        0%, 100% { opacity: 0.3; height: 50px; }
        50% { opacity: 1; height: 60px; }
    }

    /* ========================================
       Story Section
    ======================================== */

    .about-story {
        padding: 120px 40px;
        background: var(--cream);
        position: relative;
    }

    .story-container {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 80px;
        align-items: center;
    }

    .story-image {
        position: relative;
    }

    .story-image-main {
        width: 100%;
        height: 500px;
        object-fit: cover;
        box-shadow: var(--shadow-strong);
    }

    .story-image-frame {
        position: absolute;
        top: 30px;
        left: 30px;
        right: -30px;
        bottom: -30px;
        border: 2px solid var(--copper);
        pointer-events: none;
        z-index: -1;
    }

    .story-content {
        padding-left: 20px;
    }

    .section-label {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
        color: var(--copper);
        font-family: var(--font-body);
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.2em;
    }

    .section-label::before {
        content: '';
        width: 40px;
        height: 2px;
        background: var(--copper);
    }

    .story-title {
        font-size: clamp(2.5rem, 4vw, 3.5rem);
        color: var(--charcoal);
        line-height: 1.2;
        margin-bottom: 30px;
    }

    .story-text {
        font-size: 1.1rem;
        color: var(--charcoal-light);
        line-height: 1.9;
        margin-bottom: 25px;
    }

    .story-pullquote {
        position: relative;
        padding: 30px 0 30px 30px;
        margin: 40px 0;
        border-left: 3px solid var(--copper);
        font-family: var(--font-display);
        font-size: 1.6rem;
        font-style: italic;
        color: var(--walnut);
        line-height: 1.6;
    }

    .story-pullquote::before {
        content: '"';
        position: absolute;
        top: 0;
        left: 15px;
        font-size: 4rem;
        color: var(--copper);
        opacity: 0.3;
        line-height: 1;
    }

    /* ========================================
       Timeline Section
    ======================================== */

    .about-timeline {
        padding: 120px 40px;
        background: var(--charcoal);
        position: relative;
        overflow: hidden;
    }

    .about-timeline::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
        opacity: 0.03;
    }

    .timeline-container {
        max-width: 1000px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }

    .timeline-header {
        text-align: center;
        margin-bottom: 80px;
    }

    .timeline-header .section-label {
        justify-content: center;
        color: var(--copper-light);
    }

    .timeline-header .section-label::before,
    .timeline-header .section-label::after {
        content: '';
        width: 40px;
        height: 2px;
        background: var(--copper);
    }

    .timeline-title {
        font-size: clamp(2.5rem, 4vw, 3.5rem);
        color: var(--cream);
        margin-top: 20px;
    }

    .timeline-track {
        position: relative;
        padding: 40px 0;
    }

    .timeline-track::before {
        content: '';
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 2px;
        height: 100%;
        background: var(--walnut-light);
    }

    .timeline-item {
        display: flex;
        align-items: center;
        margin-bottom: 60px;
        position: relative;
        opacity: 0;
        transform: translateY(30px);
        animation: timelineReveal 0.6s ease-out forwards;
    }

    .timeline-item:nth-child(1) { animation-delay: 0.1s; }
    .timeline-item:nth-child(2) { animation-delay: 0.2s; }
    .timeline-item:nth-child(3) { animation-delay: 0.3s; }
    .timeline-item:nth-child(4) { animation-delay: 0.4s; }
    .timeline-item:nth-child(5) { animation-delay: 0.5s; }

    @keyframes timelineReveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .timeline-item:nth-child(odd) {
        flex-direction: row;
        text-align: right;
    }

    .timeline-item:nth-child(even) {
        flex-direction: row-reverse;
        text-align: left;
    }

    .timeline-content {
        flex: 1;
        padding: 0 50px;
    }

    .timeline-year {
        font-family: var(--font-display);
        font-size: 3rem;
        font-weight: 600;
        color: var(--copper);
        line-height: 1;
        margin-bottom: 10px;
    }

    .timeline-event {
        font-size: 1.2rem;
        color: var(--cream);
        margin-bottom: 8px;
    }

    .timeline-desc {
        font-size: 0.95rem;
        color: var(--warm-gray);
        line-height: 1.6;
    }

    .timeline-marker {
        width: 24px;
        height: 24px;
        background: var(--copper);
        border: 4px solid var(--charcoal);
        border-radius: 50%;
        position: relative;
        z-index: 2;
        flex-shrink: 0;
        transition: all 0.3s ease;
    }

    .timeline-item:hover .timeline-marker {
        transform: scale(1.3);
        box-shadow: 0 0 20px var(--copper-glow);
    }

    /* ========================================
       What Sets Us Apart
    ======================================== */

    .about-difference {
        padding: 120px 40px;
        background: var(--cream-dark);
        position: relative;
    }

    .difference-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .difference-header {
        max-width: 600px;
        margin-bottom: 80px;
    }

    .difference-title {
        font-size: clamp(2.5rem, 4vw, 3.5rem);
        color: var(--charcoal);
        line-height: 1.2;
        margin-top: 20px;
    }

    .difference-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto auto;
        gap: 30px;
    }

    .difference-card {
        background: var(--cream);
        padding: 50px;
        position: relative;
        overflow: hidden;
        transition: all 0.4s ease;
    }

    .difference-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, var(--copper), var(--walnut));
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.4s ease;
    }

    .difference-card:hover::before {
        transform: scaleX(1);
    }

    .difference-card:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-strong);
    }

    .difference-card:first-child {
        grid-row: span 2;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .difference-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, var(--walnut), var(--walnut-light));
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 25px;
        position: relative;
    }

    .difference-icon::after {
        content: '';
        position: absolute;
        inset: 8px;
        border: 1px solid var(--copper);
    }

    .difference-icon i {
        font-size: 1.6rem;
        color: var(--cream);
    }

    .difference-card-title {
        font-size: 1.6rem;
        color: var(--charcoal);
        margin-bottom: 15px;
    }

    .difference-card-text {
        font-size: 1.05rem;
        color: var(--charcoal-light);
        line-height: 1.8;
    }

    /* ========================================
       Values Section
    ======================================== */

    .about-values {
        padding: 120px 40px;
        background: var(--cream);
    }

    .values-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .values-header {
        text-align: center;
        margin-bottom: 80px;
    }

    .values-title {
        font-size: clamp(2.5rem, 4vw, 3.5rem);
        color: var(--charcoal);
        margin-top: 20px;
    }

    .values-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px;
    }

    .value-card {
        text-align: center;
        padding: 50px 30px;
        background: var(--cream);
        border: 1px solid var(--warm-gray-light);
        position: relative;
        transition: all 0.4s ease;
    }

    .value-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, var(--walnut), var(--copper));
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .value-card:hover::before {
        opacity: 1;
    }

    .value-card:hover {
        border-color: transparent;
        transform: translateY(-5px);
        box-shadow: var(--shadow-medium);
    }

    .value-card-inner {
        position: relative;
        z-index: 1;
    }

    .value-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 25px;
        background: transparent;
        border: 2px solid var(--walnut);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.4s ease;
    }

    .value-card:hover .value-icon {
        background: rgba(255,255,255,0.2);
        border-color: var(--cream);
    }

    .value-icon i {
        font-size: 1.8rem;
        color: var(--walnut);
        transition: color 0.4s ease;
    }

    .value-card:hover .value-icon i {
        color: var(--cream);
    }

    .value-title {
        font-size: 1.4rem;
        color: var(--charcoal);
        margin-bottom: 12px;
        transition: color 0.4s ease;
    }

    .value-card:hover .value-title {
        color: var(--cream);
    }

    .value-text {
        font-size: 0.95rem;
        color: var(--charcoal-light);
        line-height: 1.7;
        transition: color 0.4s ease;
    }

    .value-card:hover .value-text {
        color: rgba(255,255,255,0.85);
    }

    /* ========================================
       Stats Section
    ======================================== */

    .about-stats {
        padding: 100px 40px;
        background: linear-gradient(135deg, var(--walnut) 0%, var(--walnut-dark) 100%);
        position: relative;
        overflow: hidden;
    }

    .about-stats::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
        opacity: 0.05;
    }

    .stats-container {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 40px;
        position: relative;
        z-index: 1;
    }

    .stat-item {
        text-align: center;
        padding: 30px;
        position: relative;
    }

    .stat-item::after {
        content: '';
        position: absolute;
        top: 20%;
        right: 0;
        height: 60%;
        width: 1px;
        background: rgba(255,255,255,0.15);
    }

    .stat-item:last-child::after {
        display: none;
    }

    .stat-number {
        font-family: var(--font-display);
        font-size: clamp(3rem, 5vw, 4rem);
        font-weight: 600;
        color: var(--copper-light);
        line-height: 1;
        margin-bottom: 10px;
    }

    .stat-label {
        font-size: 1rem;
        color: rgba(255,255,255,0.8);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    /* ========================================
       Certifications Section
    ======================================== */

    .about-certifications {
        padding: 120px 40px;
        background: var(--cream);
    }

    .certifications-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .certifications-header {
        text-align: center;
        margin-bottom: 80px;
    }

    .certifications-title {
        font-size: clamp(2.5rem, 4vw, 3.5rem);
        color: var(--charcoal);
        margin-top: 20px;
    }

    .certifications-subtitle {
        font-size: 1.15rem;
        color: var(--charcoal-light);
        max-width: 600px;
        margin: 20px auto 0;
        line-height: 1.7;
    }

    .certifications-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 30px;
    }

    .cert-card {
        background: var(--cream);
        border: 1px solid var(--warm-gray-light);
        padding: 40px 25px;
        text-align: center;
        position: relative;
        transition: all 0.4s ease;
    }

    .cert-card::before {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: var(--copper);
        transform: scaleX(0);
        transition: transform 0.4s ease;
    }

    .cert-card:hover::before {
        transform: scaleX(1);
    }

    .cert-card:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-medium);
        border-color: var(--copper);
    }

    .cert-logo {
        height: 70px;
        width: auto;
        margin-bottom: 20px;
        filter: grayscale(30%);
        transition: filter 0.4s ease;
    }

    .cert-card:hover .cert-logo {
        filter: grayscale(0%);
    }

    .cert-name {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--charcoal);
        margin-bottom: 8px;
    }

    .cert-desc {
        font-size: 0.85rem;
        color: var(--warm-gray);
        line-height: 1.5;
    }

    /* ========================================
       Service Areas
    ======================================== */

    .about-areas {
        padding: 100px 40px;
        background: var(--cream-dark);
    }

    .areas-container {
        max-width: 1000px;
        margin: 0 auto;
        text-align: center;
    }

    .areas-title {
        font-size: 2rem;
        color: var(--charcoal);
        margin-bottom: 20px;
    }

    .areas-text {
        font-size: 1.1rem;
        color: var(--charcoal-light);
        line-height: 1.8;
        margin-bottom: 30px;
    }

    .areas-tags {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
    }

    .area-tag {
        padding: 10px 22px;
        background: var(--cream);
        border: 1px solid var(--warm-gray-light);
        color: var(--charcoal);
        font-size: 0.95rem;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .area-tag:hover {
        background: var(--walnut);
        border-color: var(--walnut);
        color: var(--cream);
        transform: translateY(-2px);
    }

    /* ========================================
       CTA Section
    ======================================== */

    .about-cta {
        padding: 140px 40px;
        background: var(--charcoal);
        position: relative;
        overflow: hidden;
    }

    .about-cta::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -10%;
        width: 50%;
        height: 200%;
        background: linear-gradient(135deg, var(--walnut) 0%, transparent 60%);
        opacity: 0.3;
    }

    .about-cta::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
        opacity: 0.03;
    }

    .cta-container {
        max-width: 800px;
        margin: 0 auto;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .cta-title {
        font-size: clamp(2.5rem, 5vw, 4rem);
        color: var(--cream);
        line-height: 1.2;
        margin-bottom: 20px;
    }

    .cta-title em {
        font-style: italic;
        color: var(--copper-light);
    }

    .cta-text {
        font-size: 1.2rem;
        color: var(--warm-gray-light);
