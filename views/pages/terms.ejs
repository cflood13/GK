<script>
    // Smooth scroll for TOC links
    document.querySelectorAll('.terms-toc-list a').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
            e.preventDefault();
            const targetId = this.getAttribute('href');
            const targetElement = document.querySelector(targetId);
            if (targetElement) {
                const headerOffset = 80;
                const elementPosition = targetElement.getBoundingClientRect().top;
                const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

                window.scrollTo({
                    top: offsetPosition,
                    behavior: 'smooth'
                });
            }
        });
    });

    // Highlight active TOC item on scroll
    const sections = document.querySelectorAll('.terms-section[id]');
    const tocLinks = document.querySelectorAll('.terms-toc-list a');

    function highlightTOC() {
        let current = '';
        sections.forEach(section => {
            const sectionTop = section.offsetTop - 150;
            if (window.pageYOffset >= sectionTop) {
                current = section.getAttribute('id');
            }
        });

        tocLinks.forEach(link => {
            link.style.background = '';
            link.style.borderLeftColor = 'transparent';
            if (link.getAttribute('href') === '#' + current) {
                link.style.background = 'var(--terms-cream)';
                link.style.borderLeftColor = 'var(--terms-gold)';
            }
        });
    }

    window.addEventListener('scroll', highlightTOC);
    highlightTOC();
</script>
