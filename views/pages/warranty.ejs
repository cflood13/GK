<style>
/* ═══════════════════════════════════════════════════════════════════════════
   WARRANTY PAGE - "Protection & Assurance" Aesthetic
   Sophisticated, trustworthy design conveying security and peace of mind
   ═══════════════════════════════════════════════════════════════════════════ */

@import url('https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@300;400;500;600;700&display=swap');

:root {
    --warranty-navy: #1E3A5F;
    --warranty-navy-dark: #152A45;
    --warranty-blue: #3B82F6;
    --warranty-blue-light: #60A5FA;
    --warranty-platinum: #E5E7EB;
    --warranty-white: #FFFFFF;
    --warranty-gold: #D4AF37;
    --warranty-gold-light: #E5C453;
    --warranty-charcoal: #1F2937;
    --warranty-gray: #6B7280;
    --warranty-success: #10B981;
}

.warranty-page {
    font-family: 'Source Sans 3', sans-serif;
    background: var(--warranty-white);
    color: var(--warranty-charcoal);
    overflow-x: hidden;
}

/* ═══════════════════════════════════════════════════════════════════════════
   HERO SECTION
   ═══════════════════════════════════════════════════════════════════════════ */

.warranty-hero {
    position: relative;
    min-height: 85vh;
    background: linear-gradient(135deg, var(--warranty-navy) 0%, var(--warranty-navy-dark) 100%);
    display: flex;
    align-items: center;
    overflow: hidden;
}

.warranty-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
        radial-gradient(circle at 20% 80%, rgba(59, 130, 246, 0.15) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(212, 175, 55, 0.1) 0%, transparent 40%);
    pointer-events: none;
}

/* Animated shield pattern background */
.warranty-hero::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 5L45 12V28C45 38 38 46 30 50C22 46 15 38 15 28V12L30 5Z' stroke='%233B82F6' stroke-width='0.5' fill='none' opacity='0.08'/%3E%3C/svg%3E");
    background-size: 80px 80px;
    opacity: 0.5;
    animation: patternDrift 60s linear infinite;
}

@keyframes patternDrift {
    from { background-position: 0 0; }
    to { background-position: 80px 80px; }
}

.warranty-hero-content {
    position: relative;
    z-index: 2;
    max-width: 1400px;
    margin: 0 auto;
    padding: 120px 5%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
}

.warranty-hero-text {
    animation: heroFadeIn 1s ease-out;
}

@keyframes heroFadeIn {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.warranty-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(212, 175, 55, 0.15);
    border: 1px solid rgba(212, 175, 55, 0.3);
    padding: 10px 20px;
    border-radius: 50px;
    margin-bottom: 30px;
    animation: badgePulse 3s ease-in-out infinite;
}

@keyframes badgePulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.3); }
    50% { box-shadow: 0 0 20px 5px rgba(212, 175, 55, 0.15); }
}

.warranty-hero-badge i {
    color: var(--warranty-gold);
    font-size: 1rem;
}

.warranty-hero-badge span {
    color: var(--warranty-gold);
    font-family: 'Source Sans 3', sans-serif;
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.warranty-hero h1 {
    font-family: 'Libre Baskerville', serif;
    font-size: clamp(2.8rem, 5vw, 4.2rem);
    font-weight: 700;
    color: var(--warranty-white);
    line-height: 1.15;
    margin-bottom: 25px;
}

.warranty-hero h1 span {
    display: block;
    color: var(--warranty-gold);
    font-style: italic;
}

.warranty-hero-description {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    margin-bottom: 40px;
    max-width: 540px;
}

.warranty-hero-stats {
    display: flex;
    gap: 50px;
}

.warranty-stat {
    text-align: left;
}

.warranty-stat-number {
    font-family: 'Libre Baskerville', serif;
    font-size: 3rem;
    font-weight: 700;
    color: var(--warranty-gold);
    line-height: 1;
}

.warranty-stat-label {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 8px;
}

/* Hero Shield Visual */
.warranty-hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    animation: heroVisualFadeIn 1.2s ease-out 0.3s both;
}

@keyframes heroVisualFadeIn {
    from {
        opacity: 0;
        transform: scale(0.9);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

.warranty-shield-container {
    position: relative;
    width: 400px;
    height: 450px;
}

.warranty-shield {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 280px;
    height: 320px;
    background: linear-gradient(180deg, var(--warranty-blue) 0%, var(--warranty-navy) 100%);
    clip-path: polygon(50% 0%, 100% 15%, 100% 60%, 50% 100%, 0% 60%, 0% 15%);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: shieldFloat 6s ease-in-out infinite;
    box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.3),
        inset 0 0 80px rgba(255, 255, 255, 0.1);
}

@keyframes shieldFloat {
    0%, 100% { transform: translate(-50%, -50%) translateY(0); }
    50% { transform: translate(-50%, -50%) translateY(-15px); }
}

.warranty-shield::before {
    content: '';
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    bottom: 8px;
    border: 2px solid rgba(212, 175, 55, 0.5);
    clip-path: polygon(50% 0%, 100% 15%, 100% 60%, 50% 100%, 0% 60%, 0% 15%);
}

.warranty-shield-inner {
    text-align: center;
    color: var(--warranty-white);
}

.warranty-shield-inner i {
    font-size: 4rem;
    color: var(--warranty-gold);
    margin-bottom: 15px;
    display: block;
    animation: checkPulse 2s ease-in-out infinite;
}

@keyframes checkPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
}

.warranty-shield-inner span {
    font-family: 'Libre Baskerville', serif;
    font-size: 3.5rem;
    font-weight: 700;
    display: block;
    line-height: 1;
}

.warranty-shield-inner small {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    opacity: 0.8;
}

/* Orbiting elements */
.warranty-orbit {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 380px;
    height: 380px;
    border: 1px dashed rgba(59, 130, 246, 0.3);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    animation: orbitSpin 30s linear infinite;
}

@keyframes orbitSpin {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
}

.warranty-orbit-item {
    position: absolute;
    width: 50px;
    height: 50px;
    background: var(--warranty-navy);
    border: 2px solid var(--warranty-gold);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--warranty-gold);
    font-size: 1.2rem;
    animation: orbitItemSpin 30s linear infinite reverse;
}

.warranty-orbit-item:nth-child(1) { top: -25px; left: 50%; transform: translateX(-50%); }
.warranty-orbit-item:nth-child(2) { top: 50%; right: -25px; transform: translateY(-50%); }
.warranty-orbit-item:nth-child(3) { bottom: -25px; left: 50%; transform: translateX(-50%); }
.warranty-orbit-item:nth-child(4) { top: 50%; left: -25px; transform: translateY(-50%); }

@keyframes orbitItemSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

/* ═══════════════════════════════════════════════════════════════════════════
   WARRANTY TIERS SECTION
   ═══════════════════════════════════════════════════════════════════════════ */

.warranty-tiers {
    padding: 120px 5%;
    background: var(--warranty-white);
}

.warranty-tiers-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 80px;
}

.warranty-section-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--warranty-blue);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 20px;
}

.warranty-section-tag::before,
.warranty-section-tag::after {
    content: '';
    width: 30px;
    height: 2px;
    background: var(--warranty-blue);
}

.warranty-tiers h2 {
    font-family: 'Libre Baskerville', serif;
    font-size: clamp(2.2rem, 4vw, 3rem);
    color: var(--warranty-navy);
    margin-bottom: 20px;
}

.warranty-tiers-description {
    font-size: 1.15rem;
    color: var(--warranty-gray);
    line-height: 1.7;
}

.warranty-tiers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    max-width: 1300px;
    margin: 0 auto;
}

.warranty-tier-card {
    background: var(--warranty-white);
    border: 1px solid var(--warranty-platinum);
    border-radius: 20px;
    padding: 50px 40px;
    text-align: center;
    position: relative;
    transition: all 0.4s ease;
    overflow: hidden;
}

.warranty-tier-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: var(--warranty-platinum);
    transition: background 0.4s ease;
}

.warranty-tier-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 25px 60px rgba(30, 58, 95, 0.15);
    border-color: transparent;
}

.warranty-tier-card.featured {
    background: linear-gradient(180deg, var(--warranty-navy) 0%, var(--warranty-navy-dark) 100%);
    border: none;
    transform: scale(1.05);
}

.warranty-tier-card.featured::before {
    background: linear-gradient(90deg, var(--warranty-gold), var(--warranty-gold-light));
    height: 6px;
}

.warranty-tier-card.featured:hover {
    transform: scale(1.05) translateY(-10px);
}

.warranty-tier-badge {
    position: absolute;
    top: 25px;
    right: 25px;
    background: linear-gradient(135deg, var(--warranty-gold), var(--warranty-gold-light));
    color: var(--warranty-navy);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.warranty-tier-icon {
    width: 90px;
    height: 90px;
    margin: 0 auto 30px;
    background: var(--warranty-platinum);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
}

.warranty-tier-card.featured .warranty-tier-icon {
    background: rgba(59, 130, 246, 0.2);
}

.warranty-tier-icon i {
    font-size: 2.5rem;
    color: var(--warranty-navy);
}

.warranty-tier-card.featured .warranty-tier-icon i {
    color: var(--warranty-gold);
}

.warranty-tier-icon::after {
    content: '';
    position: absolute;
    top: -5px;
    left: -5px;
    right: -5px;
    bottom: -5px;
    border: 2px dashed var(--warranty-platinum);
    border-radius: 50%;
    animation: iconDashSpin 20s linear infinite;
}

.warranty-tier-card.featured .warranty-tier-icon::after {
    border-color: rgba(212, 175, 55, 0.4);
}

@keyframes iconDashSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.warranty-tier-name {
    font-family: 'Libre Baskerville', serif;
    font-size: 1.5rem;
    color: var(--warranty-navy);
    margin-bottom: 10px;
}

.warranty-tier-card.featured .warranty-tier-name {
    color: var(--warranty-white);
}

.warranty-tier-years {
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--warranty-blue);
    line-height: 1;
    margin-bottom: 5px;
}

.warranty-tier-card.featured .warranty-tier-years {
    color: var(--warranty-gold);
}

.warranty-tier-years span {
    font-size: 1rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 2px;
}

.warranty-tier-description {
    font-size: 0.95rem;
    color: var(--warranty-gray);
    margin: 20px 0 30px;
    line-height: 1.6;
}

.warranty-tier-card.featured .warranty-tier-description {
    color: rgba(255, 255, 255, 0.7);
}

.warranty-tier-features {
    list-style: none;
    padding: 0;
    margin: 0 0 30px;
    text-align: left;
}

.warranty-tier-features li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--warranty-platinum);
    font-size: 0.95rem;
    color: var(--warranty-charcoal);
}

.warranty-tier-card.featured .warranty-tier-features li {
    border-color: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.9);
}

.warranty-tier-features li:last-child {
    border-bottom: none;
}

.warranty-tier-features li i {
    color: var(--warranty-success);
    font-size: 1rem;
    margin-top: 3px;
    flex-shrink: 0;
}

.warranty-tier-card.featured .warranty-tier-features li i {
    color: var(--warranty-gold);
}

.warranty-tier-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 32px;
    background: var(--warranty-navy);
    color: var(--warranty-white);
    text-decoration: none;
    font-weight: 600;
    border-radius: 8px;
    transition: all 0.3s ease;
}

.warranty-tier-card.featured .warranty-tier-cta {
    background: linear-gradient(135deg, var(--warranty-gold), var(--warranty-gold-light));
    color: var(--warranty-navy);
}

.warranty-tier-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(30, 58, 95, 0.3);
}

.warranty-tier-card.featured .warranty-tier-cta:hover {
    box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
}

/* ═══════════════════════════════════════════════════════════════════════════
   MANUFACTURER PARTNERS SECTION
   ═══════════════════════════════════════════════════════════════════════════ */

.warranty-manufacturers {
    padding: 100px 5%;
    background: var(--warranty-platinum);
    position: relative;
}

.warranty-manufacturers::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M20 0v40M0 20h40' stroke='%23D1D5DB' stroke-width='1'/%3E%3C/svg%3E");
    opacity: 0.5;
}

.warranty-manufacturers-content {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
}

.warranty-manufacturers h2 {
    font-family: 'Libre Baskerville', serif;
    font-size: clamp(2rem, 3.5vw, 2.5rem);
    color: var(--warranty-navy);
    margin-bottom: 20px;
}

.warranty-manufacturers-description {
    font-size: 1.1rem;
    color: var(--warranty-gray);
    max-width: 600px;
    margin: 0 auto 60px;
}

.warranty-manufacturers-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
    max-width: 900px;
    margin: 0 auto;
}

.warranty-manufacturer-card {
    background: var(--warranty-white);
    border-radius: 20px;
    padding: 50px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
    transition: all 0.4s ease;
}

.warranty-manufacturer-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.1);
}

.warranty-manufacturer-logo {
    height: 60px;
    margin-bottom: 25px;
    object-fit: contain;
    filter: grayscale(0);
    transition: filter 0.3s ease;
}

.warranty-manufacturer-card h3 {
    font-family: 'Libre Baskerville', serif;
    font-size: 1.4rem;
    color: var(--warranty-navy);
    margin-bottom: 15px;
}

.warranty-manufacturer-card p {
    font-size: 0.95rem;
    color: var(--warranty-gray);
    line-height: 1.6;
    margin-bottom: 20px;
}

.warranty-manufacturer-features {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
}

.warranty-manufacturer-feature {
    background: var(--warranty-platinum);
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    color: var(--warranty-navy);
    font-weight: 500;
}

/* ═══════════════════════════════════════════════════════════════════════════
   WARRANTY PROCESS TIMELINE
   ═══════════════════════════════════════════════════════════════════════════ */

.warranty-process {
    padding: 120px 5%;
    background: var(--warranty-white);
}

.warranty-process-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 80px;
}

.warranty-process h2 {
    font-family: 'Libre Baskerville', serif;
    font-size: clamp(2.2rem, 4vw, 3rem);
    color: var(--warranty-navy);
    margin-bottom: 20px;
}

.warranty-process-description {
    font-size: 1.15rem;
    color: var(--warranty-gray);
    line-height: 1.7;
}

.warranty-timeline {
    max-width: 1000px;
    margin: 0 auto;
    position: relative;
}

.warranty-timeline::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 3px;
    height: 100%;
    background: linear-gradient(180deg, var(--warranty-blue), var(--warranty-gold));
    transform: translateX(-50%);
    border-radius: 3px;
}

.warranty-timeline-item {
    display: flex;
    align-items: center;
    gap: 60px;
    margin-bottom: 60px;
    position: relative;
}

.warranty-timeline-item:nth-child(even) {
    flex-direction: row-reverse;
}

.warranty-timeline-item:last-child {
    margin-bottom: 0;
}

.warranty-timeline-content {
    flex: 1;
    background: var(--warranty-white);
    border: 1px solid var(--warranty-platinum);
    border-radius: 16px;
    padding: 35px;
    position: relative;
    transition: all 0.3s ease;
}

.warranty-timeline-content:hover {
    box-shadow: 0 15px 40px rgba(30, 58, 95, 0.1);
    border-color: var(--warranty-blue);
}

.warranty-timeline-step {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--warranty-blue);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 10px;
}

.warranty-timeline-content h3 {
    font-family: 'Libre Baskerville', serif;
    font-size: 1.4rem;
    color: var(--warranty-navy);
    margin-bottom: 12px;
}

.warranty-timeline-content p {
    font-size: 1rem;
    color: var(--warranty-gray);
    line-height: 1.6;
}

.warranty-timeline-icon {
    width: 70px;
    height: 70px;
    background: var(--warranty-navy);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--warranty-gold);
    font-size: 1.5rem;
    position: relative;
    z-index: 2;
    flex-shrink: 0;
    box-shadow: 0 10px 30px rgba(30, 58, 95, 0.3);
}

.warranty-timeline-spacer {
    flex: 1;
}

/* ═══════════════════════════════════════════════════════════════════════════
   FAQ ACCORDION SECTION
   ═══════════════════════════════════════════════════════════════════════════ */

.warranty-faq {
    padding: 120px 5%;
    background: linear-gradient(180deg, var(--warranty-platinum) 0%, var(--warranty-white) 100%);
}

.warranty-faq-container {
    max-width: 900px;
    margin: 0 auto;
}

.warranty-faq-header {
    text-align: center;
    margin-bottom: 60px;
}

.warranty-faq h2 {
    font-family: 'Libre Baskerville', serif;
    font-size: clamp(2.2rem, 4vw, 3rem);
    color: var(--warranty-navy);
    margin-bottom: 20px;
}

.warranty-faq-description {
    font-size: 1.15rem;
    color: var(--warranty-gray);
}

.warranty-accordion {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.warranty-accordion-item {
    background: var(--warranty-white);
    border: 1px solid var(--warranty-platinum);
    border-radius: 12px;
    overflow: hidden;
