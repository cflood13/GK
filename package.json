{
  "name": "gk-website",
  "version": "1.0.0",
  "description": "GK Homes and Roofing - Professional roofing and construction services in Central Texas",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "npm run css:watch & nodemon server.js",
    "dev:server": "nodemon server.js",
    "css:build": "npx @tailwindcss/cli -i ./src/tailwind.css -o ./public/css/tailwind.css --minify",
    "css:watch": "npx @tailwindcss/cli -i ./src/tailwind.css -o ./public/css/tailwind.css --watch",
    "build": "npm run css:build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "roofing",
    "construction",
    "remodeling",
    "austin",
    "texas"
  ],
  "author": "GK Homes and Roofing",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^2.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-ejs-layouts": "^2.5.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "openai": "^5.10.2",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.1.18"
  }
}
